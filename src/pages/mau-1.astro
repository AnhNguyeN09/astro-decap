<script>
  // Auto & Dot Slide Switcher for Bento Hero
  let currentBentoSlide = 0;
  const slidePanels = document.querySelectorAll('.bento-slide-panel');
  const totalBentoSlides = slidePanels.length;

  function showBentoSlide(index: number) {
    if (totalBentoSlides === 0) return;
    currentBentoSlide = (index + totalBentoSlides) % totalBentoSlides;
    slidePanels.forEach((p, i) => {
      p.classList.toggle('active', i === currentBentoSlide);
    });
  }

  document.querySelectorAll('.bento-dot').forEach((dot) => {
    dot.addEventListener('click', () => {
      const idx = Number(dot.getAttribute('data-slide-idx') || 0);
      showBentoSlide(idx);
    });
  });

  setInterval(() => {
    showBentoSlide(currentBentoSlide + 1);
  }, 5500);

  // Mobile Menu Toggle
  const mobileBtn = document.getElementById('bentoMobileBtn');
  const bentoNav = document.getElementById('bentoNav');
  mobileBtn?.addEventListener('click', () => {
    bentoNav?.classList.toggle('open');
  });
</script>

