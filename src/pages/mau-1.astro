---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FloatingContact from '../components/FloatingContact.astro';

// Lấy dữ liệu thực từ Decap CMS
const homeEntry = await getEntry('homepage', 'index');
const homeData = homeEntry?.data;

const slides = homeData?.slides || [];
const about = homeData?.about || {
  heading: "Xây dựng Phần Mềm & Thiết Kế Website Chuyên Nghiệp",
  subLabel: "VỀ ABSOLTECH",
  content: "Thành lập tháng 12 năm 2007 - ABSoltech trải qua hơn 16 năm phát triển, chúng tôi đã trở thành thương hiệu doanh nghiệp CNTT hàng đầu tại khu vực Duyên Hải.",
  quote: "Sứ mệnh của chúng tôi là mang đến giá trị thặng dư lớn và sự thành công cho khách hàng",
  teamImage: "https://absoltech.vn/wp-content/uploads/2023/09/teamworks-absoltech-1024x683.jpg"
};
const servicesSec = homeData?.servicesSection || {
  subTitle: "CÁC DỊCH VỤ MÀ ABSOLTECH CUNG CẤP",
  title: "Dịch Vụ",
  desc: "Giải pháp công nghệ toàn diện nâng tầm doanh nghiệp trong kỷ nguyên số.",
  items: []
};
const productsSec = homeData?.productsSection || {
  subTitle: "SẢN PHẨM",
  title: "Phần Mềm Đóng Gói",
  desc: "Hệ sinh thái phần mềm đóng gói giải quyết triệt để bài toán vận hành của từng ngành nghề.",
  items: []
};
const callout = homeData?.callout || {
  title: "Bạn đang quan tâm tới chuyển đổi số?",
  desc: "Với kinh nghiệm hơn 20 năm triển khai ứng dụng CNTT trong nhiều lĩnh vực, các chuyên gia của chúng tôi sẽ đưa ra giải pháp tốt nhất cho doanh nghiệp của bạn",
  phone: "0985 18 5665"
};

const reviews = [
  {
    author: "Mr. David Henry",
    company: "DHM Digital",
    role: "CEO & Founder",
    quote: "Đội ngũ chuyên nghiệp dẫn đầu bởi Mr Công. Nhân ngày kỉ niệm 10 năm thành lập, các bạn đã luôn làm rất tốt. Hãy tiếp tục giữ vững tinh thần và hoàn thành tốt công việc nhé.",
    avatar: "DH"
  },
  {
    author: "Ms. Renae Christine",
    company: "OWHO",
    role: "Product Director",
    quote: "Những lập trình viên bậc A++, giao tiếp rất tốt. Họ vô cùng hữu ích và luôn túc trực sẵn sàng xử lý vấn đề, sự cố khẩn cấp cho bạn.",
    avatar: "RC"
  },
  {
    author: "Mr. Blake Bridge",
    company: "Room Connection",
    role: "Managing Partner",
    quote: "Tôi đã làm việc với ABSoft trong gần 2 năm để phát triển ứng dụng, trang web và nền tảng của mình. Họ là những người giỏi nhất trong công việc này. Giao tiếp hiệu quả, phản hồi nhanh chóng.",
    avatar: "BB"
  },
  {
    author: "Mr. Scott Price",
    company: "Marketing Solution",
    role: "Technical Lead",
    quote: "Chắc chắn là 1 công ty tuyệt vời rồi. Tôi đã hợp tác với Công và đội ngũ của anh ấy cho rất nhiều dự án và sẽ thêm nhiều dự án hơn nữa trong tương lai.",
    avatar: "SP"
  }
];

const partners = [
  { name: "SoftBank", country: "Nhật Bản", desc: "Tập đoàn Viễn thông & Công nghệ", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-softbank.png" },
  { name: "Bijin-Tokei", country: "Nhật Bản", desc: "Nền tảng Truyền thông & Giải trí số", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-bijint.png" },
  { name: "World Air Plan", country: "Nhật Bản", desc: "Hệ thống Du lịch & Hàng không", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-wap.png" },
  { name: "CyberAgent", country: "Nhật Bản", desc: "Tập đoàn Internet & Quảng cáo số", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-cyberagent.png" }
];
---

<Layout>
  <div class="bento-theme-wrapper">
    <!-- 1. CHUẨN HEADER 3 CẤP TỪ HEADER.ASTRO -->
    <Header />

    <main>
      <!-- 2. BENTO HERO SECTION WITH FLOATING WIDGETS -->
      <section class="bento-hero">
        <div class="container relative">
          <!-- Slides Bento Stage -->
          <div class="hero-bento-stage">
            {slides.map((s, idx) => (
              <div class={`bento-slide-panel ${idx === 0 ? 'active' : ''}`} data-panel-idx={idx}>
                <div class="bento-hero-grid">
                  <!-- Left Main Hero Bento Box -->
                  <div class="hero-main-box">
                    <div class="hero-box-top-row">
                      <div class="badge-pill">
                        <i class="fa-solid fa-sparkles"></i>
                        <span>GIẢI PHÁP CÔNG NGHỆ TOÀN DIỆN</span>
                      </div>
                      <div class="hero-slide-dots">
                        {slides.map((_, dotIdx) => (
                          <button
                            class={`bento-dot ${dotIdx === idx ? 'active' : ''}`}
                            data-slide-idx={dotIdx}
                            aria-label={`Slide ${dotIdx + 1}`}
                          ></button>
                        ))}
                      </div>
                    </div>
                    <h1 class="hero-bento-heading">
                      <span class="pre-txt">{s.pretitle}</span>
                      <span class="highlight-txt">{s.title}</span>
                    </h1>
                    <p class="hero-bento-desc">{s.description}</p>

                    <div class="hero-bento-actions">
                      <a href={s.btnPrimaryLink || '/lien-he'} class="btn-bento-solid">
                        <span>{s.btnPrimaryText || 'Kết nối ngay'}</span>
                        <i class="fa-solid fa-arrow-right"></i>
                      </a>
                      <a href={s.btnSecondaryLink || '#services'} class="btn-bento-ghost">
                        <span>{s.btnSecondaryText || 'Khám phá dịch vụ'}</span>
                        <i class="fa-solid fa-chevron-down"></i>
                      </a>
                    </div>

                    <!-- Mini Trust Metrics inside Hero Box -->
                    <div class="hero-mini-metrics">
                      <div class="m-item">
                        <strong>16+</strong>
                        <span>Năm kinh nghiệm</span>
                      </div>
                      <div class="m-divider"></div>
                      <div class="m-item">
                        <strong>500+</strong>
                        <span>Dự án vận hành</span>
                      </div>
                      <div class="m-divider"></div>
                      <div class="m-item">
                        <strong>1000+</strong>
                        <span>Khách hàng tin dùng</span>
                      </div>
                    </div>
                  </div>

                  <!-- Right Visual Showcase Bento Box -->
                  <div class="hero-visual-box">
                    <div class="visual-card-bg" style={s.bgImage ? `background-image: url('${s.bgImage}')` : ''}></div>
                    <div class="visual-mockup-wrap">
                      <img src={s.image} alt={s.title} class="mockup-img" />
                    </div>

                    <!-- Floating SaaS Badges -->
                    <div class="floating-widget widget-top-left">
                      <div class="w-icon"><i class="fa-solid fa-shield-halved"></i></div>
                      <div class="w-text">
                        <strong>Chuẩn Quốc Tế</strong>
                        <span>Nhật Bản • Hàn Quốc • Úc</span>
                      </div>
                    </div>

                    <div class="floating-widget widget-bottom-right">
                      <div class="w-icon cyan"><i class="fa-solid fa-bolt"></i></div>
                      <div class="w-text">
                        <strong>Hỗ trợ SLA 24/7</strong>
                        <span>Tận tâm đồng hành</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- Marquee Bento Bar -->
          <div class="bento-marquee-bar">
            <div class="marquee-label">
              <i class="fa-solid fa-layer-group"></i>
              <span>Năng lực cốt lõi</span>
            </div>
            <div class="marquee-track-clip">
              <div class="marquee-track">
                <span>Phát triển phần mềm</span> <i class="fa-solid fa-circle"></i>
                <span>Tư vấn giải pháp CNTT</span> <i class="fa-solid fa-circle"></i>
                <span>Giải pháp thương mại điện tử</span> <i class="fa-solid fa-circle"></i>
                <span>Xây dựng ứng dụng di động</span> <i class="fa-solid fa-circle"></i>
                <span>Giải pháp đám mây</span> <i class="fa-solid fa-circle"></i>
                <span>Xây dựng website chuẩn SEO</span> <i class="fa-solid fa-circle"></i>
                <span>Xử lý dữ liệu & Chuyển đổi số</span> <i class="fa-solid fa-circle"></i>
                <span>Hệ quản trị CMS & CRM</span> <i class="fa-solid fa-circle"></i>
                <!-- Duplicate for seamless loop -->
                <span>Phát triển phần mềm</span> <i class="fa-solid fa-circle"></i>
                <span>Tư vấn giải pháp CNTT</span> <i class="fa-solid fa-circle"></i>
                <span>Giải pháp thương mại điện tử</span> <i class="fa-solid fa-circle"></i>
                <span>Xây dựng ứng dụng di động</span> <i class="fa-solid fa-circle"></i>
                <span>Giải pháp đám mây</span> <i class="fa-solid fa-circle"></i>
                <span>Xây dựng website chuẩn SEO</span> <i class="fa-solid fa-circle"></i>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. BENTO SERVICES SECTION (ASYMMETRIC BENTO GRID) -->
      <section class="bento-services-sec" id="services">
        <div class="container">
          <div class="bento-sec-header">
            <span class="bento-eyebrow">{servicesSec.subTitle}</span>
            <h2 class="bento-sec-title">{servicesSec.title} & Giải Pháp Trọng Tâm</h2>
            <p class="bento-sec-desc">{servicesSec.desc}</p>
          </div>

          <div class="services-bento-grid">
            {servicesSec.items.map((item, idx) => {
              // Làm nổi bật ô số 1 và ô số 5 thành ô Bento rộng (span 2 cột)
              const isWide = idx === 0 || idx === 4;
              const isHighlighted = idx === 0;
              return (
                <div class={`bento-service-card ${isWide ? 'span-2' : ''} ${isHighlighted ? 'theme-primary' : ''}`}>
                  <div class="b-card-top">
                    <div class="b-icon-box">
                      <i class={item.icon}></i>
                    </div>
                    <span class="b-tag">{item.tag}</span>
                  </div>

                  <div class="b-card-body">
                    <h3 class="b-title">{item.title}</h3>
                    <p class="b-desc">{item.desc}</p>
                  </div>

                  <div class="b-card-footer">
                    <a href="/lien-he" class="b-explore-link">
                      <span>Tư vấn giải pháp</span>
                      <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <span class="b-index">0{idx + 1}</span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>

      <!-- 4. BENTO ABOUT & JAPANESE PARTNERS SECTION -->
      <section class="bento-about-sec" id="about">
        <div class="container">
          <div class="about-bento-mosaic">
            <!-- Tile 1: Main Story (Large Left) -->
            <div class="bento-tile tile-story">
              <span class="bento-eyebrow">{about.subLabel}</span>
              <h2 class="tile-heading">{about.heading}</h2>
              <p class="tile-text">{about.content}</p>

              <div class="tile-quote-box">
                <i class="fa-solid fa-quote-left"></i>
                <p>{about.quote}</p>
              </div>
            </div>

            <!-- Tile 2: Team Visual (Top Right) -->
            <div class="bento-tile tile-team-photo">
              <img src={about.teamImage} alt="Đội ngũ ABSoltech" />
              <div class="photo-overlay-badge">
                <div class="po-years">16+</div>
                <div class="po-txt">
                  <strong>Năm phát triển</strong>
                  <span>Thương hiệu CNTT hàng đầu Duyên Hải</span>
                </div>
              </div>
            </div>

            <!-- Tile 3: International Partners (Bottom Left) -->
            <div class="bento-tile tile-partners">
              <div class="tp-top-block">
                <div class="tp-head">
                  <span class="tp-label"><i class="fa-solid fa-globe"></i> ĐỐI TÁC CHIẾN LƯỢC QUỐC TẾ</span>
                  <span class="tp-sub">Nhật Bản • Hàn Quốc • Australia</span>
                </div>
                <p class="tp-intro">
                  Hợp tác phát triển và gia công phần mềm theo quy trình kiểm định chất lượng khắt khe cho các tập đoàn công nghệ hàng đầu châu Á.
                </p>
              </div>

              <div class="tp-logos">
                {partners.map((p) => (
                  <div class="tp-logo-item" title={p.name}>
                    <div class="tp-logo-img-wrap">
                      <img src={p.logo} alt={p.name} />
                    </div>
                    <div class="tp-logo-meta">
                      <strong>{p.name}</strong>
                      <span>{p.desc}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Tile 4: Stats Bento Highlight (Bottom Right) -->
            <div class="bento-tile tile-stats-highlight">
              <div class="sh-grid">
                <div class="sh-item">
                  <span class="sh-num">05</span>
                  <span class="sh-lbl">Quốc gia triển khai</span>
                </div>
                <div class="sh-item">
                  <span class="sh-num">20+</span>
                  <span class="sh-lbl">Đối tác tập đoàn lớn</span>
                </div>
                <div class="sh-item">
                  <span class="sh-num">500+</span>
                  <span class="sh-lbl">Dự án thành công</span>
                </div>
                <div class="sh-item">
                  <span class="sh-num">1000+</span>
                  <span class="sh-lbl">Khách hàng doanh nghiệp</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. BENTO PACKAGED PRODUCTS SHOWCASE -->
      <section class="bento-products-sec" id="products">
        <div class="container">
          <div class="bento-sec-header">
            <span class="bento-eyebrow">{productsSec.subTitle}</span>
            <h2 class="bento-sec-title">{productsSec.title}</h2>
            <p class="bento-sec-desc">{productsSec.desc}</p>
          </div>

          <div class="products-bento-grid">
            {productsSec.items.map((prod) => (
              <div class="bento-product-card">
                <div class="bp-visual-stage">
                  <span class="bp-badge">{prod.badge}</span>
                  <img src={prod.image} alt={prod.name} loading="lazy" />
                </div>
                <div class="bp-content">
                  <div class="bp-title-row">
                    <h3 class="bp-name">{prod.name}</h3>
                    <a href="/lien-he" class="bp-icon-btn" aria-label={`Tìm hiểu ${prod.name}`}>
                      <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    </a>
                  </div>
                  <span class="bp-tagline">{prod.tagline}</span>
                  <p class="bp-desc">{prod.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 6. BENTO WALL OF LOVE (TESTIMONIALS) -->
      <section class="bento-testimonials-sec" id="testimonials">
        <div class="container">
          <div class="bento-sec-header">
            <span class="bento-eyebrow">ĐÁNH GIÁ TỪ KHÁCH HÀNG QUỐC TẾ</span>
            <h2 class="bento-sec-title">Khách Hàng Nói Gì Về ABSoltech</h2>
            <p class="bento-sec-desc">Sự hài lòng và tin tưởng của các đối tác toàn cầu là minh chứng rõ nét nhất cho chất lượng dịch vụ.</p>
          </div>

          <div class="reviews-bento-grid">
            {reviews.map((r) => (
              <div class="bento-review-card">
                <div class="br-top">
                  <div class="br-stars">
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                  </div>
                  <i class="fa-solid fa-quote-right br-quote-icon"></i>
                </div>
                <p class="br-text">“{r.quote}”</p>
                <div class="br-author">
                  <div class="br-avatar">{r.avatar}</div>
                  <div>
                    <strong class="br-name">{r.author}</strong>
                    <span class="br-company">{r.role} — {r.company}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 7. BENTO CALLOUT & QUICK CONNECT FOOTER -->
      <section class="bento-callout-sec">
        <div class="container">
          <div class="callout-bento-banner">
            <div class="cb-content">
              <span class="cb-badge"><i class="fa-solid fa-rocket"></i> SẴN SÀNG CHUYỂN ĐỔI SỐ</span>
              <h2>{callout.title}</h2>
              <p>{callout.desc}</p>
            </div>
            <div class="cb-actions">
              <a href={`tel:${callout.phone.replace(/\s+/g, '')}`} class="btn-cb-phone">
                <div class="phone-ring"><i class="fa-solid fa-phone-volume"></i></div>
                <div class="phone-txt">
                  <span>Hotline tư vấn 24/7</span>
                  <strong>{callout.phone}</strong>
                </div>
              </a>
              <a href="/lien-he" class="btn-cb-contact">
                <span>Đặt lịch tư vấn</span>
                <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- 8. BENTO FOOTER WITH INTEGRATED QUICK FORM -->
    <footer class="bento-footer">
      <div class="container">
        <div class="footer-bento-grid">
          <!-- Left: Company & Branches Bento Card -->
          <div class="f-bento-info">
            <img src="https://absoltech.vn/wp-content/uploads/2025/08/logo_dark_h400-768x132.png" alt="ABSoltech" class="f-logo" />
            <h3 class="f-company-name">CÔNG TY CỔ PHẦN PHẦN MỀM AN BIÊN</h3>
            <p class="f-legal">MSDN: 0200838952 cấp ngày 07/11/2009 tại Sở KH&ĐT TP. Hải Phòng</p>

            <div class="f-branches-list">
              <div class="fb-item">
                <i class="fa-solid fa-building"></i>
                <div>
                  <strong>Trụ sở Hải Phòng:</strong>
                  <span>Tầng 4, 22 Lý Tự Trọng, Hồng Bàng, Hải Phòng</span>
                </div>
              </div>
              <div class="fb-item">
                <i class="fa-solid fa-location-dot"></i>
                <div>
                  <strong>Văn phòng Hà Nội:</strong>
                  <span>Số 4, LK4 - TT1, 96-96B Nguyễn Huy Tưởng, Thanh Xuân, Hà Nội</span>
                </div>
              </div>
              <div class="fb-item">
                <i class="fa-solid fa-location-dot"></i>
                <div>
                  <strong>Văn phòng TP.HCM:</strong>
                  <span>383 Nguyễn Duy Trinh, Bình Trưng Tây, TP. Thủ Đức, TP.HCM</span>
                </div>
              </div>
              <div class="fb-item">
                <i class="fa-solid fa-location-dot"></i>
                <div>
                  <strong>Văn phòng Thanh Hóa:</strong>
                  <span>11 Cửa Hữu, Phường Tân Sơn, TP. Thanh Hóa</span>
                </div>
              </div>
            </div>

            <div class="f-direct-pills">
              <a href="tel:+84985185665"><i class="fa-solid fa-phone"></i> (+84) 985 185 665</a>
              <a href="tel:+842257106222"><i class="fa-solid fa-phone"></i> (+84) 225 710 6222</a>
              <a href="mailto:contact@absoltech.vn"><i class="fa-regular fa-envelope"></i> contact@absoltech.vn</a>
            </div>
          </div>

          <!-- Right: Modern Contact Card -->
          <div class="f-bento-form-card">
            <div class="fbf-head">
              <span class="fbf-tag">KẾT NỐI VỚI CHÚNG TÔI</span>
              <h3>Nhận tư vấn & Báo giá giải pháp</h3>
              <p>Chuyên gia ABSoltech sẽ liên hệ phản hồi trong vòng 24 giờ.</p>
            </div>

            <form class="fbf-form" onsubmit="event.preventDefault(); alert('Cảm ơn bạn đã gửi thông tin! ABSoltech sẽ liên hệ tư vấn sớm nhất.');">
              <div class="fbf-row">
                <div class="fbf-field">
                  <label>Họ và tên *</label>
                  <input type="text" placeholder="Nguyễn Văn A" required />
                </div>
                <div class="fbf-field">
                  <label>Số điện thoại *</label>
                  <input type="tel" placeholder="0985 xxx xxx" required />
                </div>
              </div>
              <div class="fbf-row">
                <div class="fbf-field">
                  <label>Email doanh nghiệp *</label>
                  <input type="email" placeholder="contact@company.com" required />
                </div>
                <div class="fbf-field">
                  <label>Tên công ty</label>
                  <input type="text" placeholder="Công ty CP..." />
                </div>
              </div>
              <div class="fbf-field">
                <label>Nhu cầu triển khai *</label>
                <textarea rows="3" placeholder="Mô tả ngắn gọn nhu cầu phần mềm, website, mobile app..." required></textarea>
              </div>
              <button type="submit" class="fbf-submit">
                <span>Gửi yêu cầu tư vấn</span>
                <i class="fa-solid fa-paper-plane"></i>
              </button>
            </form>
          </div>
        </div>

