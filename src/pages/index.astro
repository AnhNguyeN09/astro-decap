---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroBanner from '../components/HeroBanner.astro';
import AboutSection from '../components/AboutSection.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import ProductsGrid from '../components/ProductsGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import CalloutBanner from '../components/CalloutBanner.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';

// Nạp toàn bộ dữ liệu cấu hình Trang Chủ từ Decap CMS
const homeEntry = await getEntry('homepage', 'index');
const homeData = homeEntry?.data;
---

<Layout>
  <Header />
  <main>
    <HeroBanner slides={homeData?.slides} />
    <AboutSection data={homeData?.about} />
    <ServicesGrid data={homeData?.servicesSection} />
    <Testimonials />
    <ProductsGrid data={homeData?.productsSection} />
    <!-- Khối Callout "Bạn đang quan tâm tới chuyển đổi số" thuộc trang chủ, nằm ngay trước Footer -->
    <CalloutBanner title={homeData?.callout?.title} desc={homeData?.callout?.desc} phone={homeData?.callout?.phone} />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
