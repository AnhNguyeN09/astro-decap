---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FloatingContact from '../components/FloatingContact.astro';

// Lấy dữ liệu thực từ Decap CMS
const homeEntry = await getEntry('homepage', 'index');
const homeData = homeEntry?.data;

const slides = homeData?.slides || [];
const about = homeData?.about || {
  heading: "Xây dựng Phần Mềm & Thiết Kế Website Chuyên Nghiệp",
  subLabel: "VỀ ABSOLTECH",
  content: "Thành lập tháng 12 năm 2007 - ABSoltech trải qua hơn 16 năm phát triển, chúng tôi đã trở thành thương hiệu doanh nghiệp CNTT hàng đầu tại khu vực Duyên Hải.",
  quote: "Sứ mệnh của chúng tôi là mang đến giá trị thặng dư lớn và sự thành công cho khách hàng",
  teamImage: "https://absoltech.vn/wp-content/uploads/2023/09/teamworks-absoltech-1024x683.jpg"
};
const servicesSec = homeData?.servicesSection || {
  subTitle: "CÁC DỊCH VỤ MÀ ABSOLTECH CUNG CẤP",
  title: "Dịch Vụ",
  desc: "Giải pháp công nghệ toàn diện nâng tầm doanh nghiệp trong kỷ nguyên số.",
  items: []
};
const productsSec = homeData?.productsSection || {
  subTitle: "SẢN PHẨM",
  title: "Phần Mềm Đóng Gói",
  desc: "Hệ sinh thái phần mềm đóng gói giải quyết triệt để bài toán vận hành của từng ngành nghề.",
  items: []
};
const callout = homeData?.callout || {
  title: "Bạn đang quan tâm tới chuyển đổi số?",
  desc: "Với kinh nghiệm hơn 20 năm triển khai ứng dụng CNTT trong nhiều lĩnh vực, các chuyên gia của chúng tôi sẽ đưa ra giải pháp tốt nhất cho doanh nghiệp của bạn",
  phone: "0985 18 5665"
};

const reviews = [
  {
    author: "Mr. David Henry",
    company: "DHM Digital",
    role: "CEO & Founder",
    quote: "Đội ngũ chuyên nghiệp dẫn đầu bởi Mr Công. Nhân ngày kỉ niệm 10 năm thành lập, các bạn đã luôn làm rất tốt. Hãy tiếp tục giữ vững tinh thần và hoàn thành tốt công việc nhé.",
    avatar: "DH"
  },
  {
    author: "Ms. Renae Christine",
    company: "OWHO",
    role: "Product Director",
    quote: "Những lập trình viên bậc A++, giao tiếp rất tốt. Họ vô cùng hữu ích và luôn túc trực sẵn sàng xử lý vấn đề, sự cố khẩn cấp cho bạn.",
    avatar: "RC"
  },
  {
    author: "Mr. Blake Bridge",
    company: "Room Connection",
    role: "Managing Partner",
    quote: "Tôi đã làm việc với ABSoft trong gần 2 năm để phát triển ứng dụng, trang web và nền tảng của mình. Họ là những người giỏi nhất trong công việc này. Giao tiếp hiệu quả, phản hồi nhanh chóng.",
    avatar: "BB"
  },
  {
    author: "Mr. Scott Price",
    company: "Marketing Solution",
    role: "Technical Lead",
    quote: "Chắc chắn là 1 công ty tuyệt vời rồi. Tôi đã hợp tác với Công và đội ngũ của anh ấy cho rất nhiều dự án và sẽ thêm nhiều dự án hơn nữa trong tương lai.",
    avatar: "SP"
  }
];

const partners = [
  { name: "SoftBank", desc: "Viễn thông & Công nghệ", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-softbank.png" },
  { name: "Bijin-Tokei", desc: "Truyền thông & Giải trí số", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-bijint.png" },
  { name: "World Air Plan", desc: "Du lịch & Hàng không", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-wap.png" },
  { name: "CyberAgent", desc: "Internet & Quảng cáo số", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-cyberagent.png" }
];

const stats = [
  { number: "05", suffix: "", label: "Quốc gia triển khai", icon: "fa-solid fa-earth-asia", sub: "Nhật Bản, Hàn Quốc, Úc..." },
  { number: "20", suffix: "+", label: "Đối tác chiến lược", icon: "fa-solid fa-handshake-simple", sub: "Tập đoàn công nghệ lớn" },
  { number: "500", suffix: "+", label: "Dự án hoàn thành", icon: "fa-solid fa-microchip", sub: "Phần mềm, ERP, Web & App" },
  { number: "1000", suffix: "+", label: "Khách hàng tin dùng", icon: "fa-solid fa-building-shield", sub: "Doanh nghiệp trong & ngoài nước" }
];
---

<Layout>
  <div class="tech-theme-wrapper">
    <!-- 1. CHUẨN HEADER 3 CẤP TỪ HEADER.ASTRO -->
    <Header />

    <main>
      <!-- 2. FUTURISTIC DARK CYBER-GRID HERO SECTION -->
      <section class="tech-hero-sec">
        <div class="cyber-grid-overlay"></div>
        <div class="cyber-radial-glow"></div>

        <div class="container relative">
          <div class="tech-slides-wrapper">
            {slides.map((s, idx) => (
              <div class={`tech-slide ${idx === 0 ? 'active' : ''}`} data-tech-slide={idx}>
                <div class="tech-hero-grid">
                  <!-- Left Column: Futuristic Typography & CTA -->
                  <div class="tech-hero-text">
                    <div class="tech-chip">
                      <span class="chip-dot"></span>
                      <span>ABSOLTECH DIGITAL SOLUTIONS</span>
                    </div>

                    <h1 class="tech-hero-title">
                      <span class="t-pre">{s.pretitle}</span>
                      <span class="t-main">{s.title}</span>
                    </h1>

                    <p class="tech-hero-desc">{s.description}</p>

                    <div class="tech-hero-btns">
                      <a href={s.btnPrimaryLink || '/lien-he'} class="btn-cyber-primary">
                        <span>{s.btnPrimaryText || 'Kết nối chuyên gia'}</span>
                        <i class="fa-solid fa-arrow-right"></i>
                      </a>
                      <a href={s.btnSecondaryLink || '#services'} class="btn-cyber-outline">
                        <span>{s.btnSecondaryText || 'Khám phá giải pháp'}</span>
                        <i class="fa-solid fa-chevron-right"></i>
                      </a>
                    </div>

                    <!-- Slide Navigation Controls -->
                    <div class="tech-slider-controls">
                      <button class="t-arrow" data-dir="prev" aria-label="Slide trước">
                        <i class="fa-solid fa-chevron-left"></i>
                      </button>
                      <div class="t-dots">
                        {slides.map((_, dotIdx) => (
                          <button
                            class={`t-dot ${dotIdx === idx ? 'active' : ''}`}
                            data-go={dotIdx}
                            aria-label={`Slide ${dotIdx + 1}`}
                          ></button>
                        ))}
                      </div>
                      <button class="t-arrow" data-dir="next" aria-label="Slide tiếp">
                        <i class="fa-solid fa-chevron-right"></i>
                      </button>
                    </div>
                  </div>

                  <!-- Right Column: 3D Glass HUD Showcase -->
                  <div class="tech-hero-hud">
                    <div class="hud-glass-frame">
                      <div class="hud-top-bar">
                        <div class="hud-dots">
                          <span></span><span></span><span></span>
                        </div>
                      </div>

                      <div class="hud-body">
                        <img src={s.image} alt={s.title} class="hud-mockup" />
                      </div>

                      <!-- Floating Glass Telemetry Cards -->
                      <div class="hud-float-card card-tl">
                        <i class="fa-solid fa-microchip"></i>
                        <div>
                          <strong>AI & Cloud Ready</strong>
                          <span>Hạ tầng tối ưu hiệu năng</span>
                        </div>
                      </div>

                      <div class="hud-float-card card-br">
                        <i class="fa-solid fa-shield-halved"></i>
                        <div>
                          <strong>Bảo mật Đa tầng</strong>
                          <span>Tiêu chuẩn Quốc tế ISO</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- Integrated Glass Telemetry Stats Bar -->
          <div class="tech-stats-ribbon">
            {stats.map((st) => (
              <div class="ribbon-stat-item">
                <div class="rs-icon">
                  <i class={st.icon}></i>
                </div>
                <div class="rs-info">
                  <div class="rs-num">
                    <span>{st.number}</span><span class="rs-suffix">{st.suffix}</span>
                  </div>
                  <strong class="rs-label">{st.label}</strong>
                  <span class="rs-sub">{st.sub}</span>
                </div>
              </div>
            ))}
          </div>

          <!-- Cyber Glass Marquee Bar -->
          <div class="tech-marquee-bar">
            <div class="tm-label">
              <i class="fa-solid fa-microchip"></i>
              <span>Năng lực cốt lõi</span>
            </div>
            <div class="tm-track-clip">
              <div class="tm-track">
                <span>Phát triển phần mềm</span> <i class="fa-solid fa-circle"></i>
                <span>Tư vấn giải pháp CNTT</span> <i class="fa-solid fa-circle"></i>
                <span>Giải pháp thương mại điện tử</span> <i class="fa-solid fa-circle"></i>
                <span>Xây dựng ứng dụng di động</span> <i class="fa-solid fa-circle"></i>
                <span>Giải pháp đám mây</span> <i class="fa-solid fa-circle"></i>
                <span>Xây dựng website chuẩn SEO</span> <i class="fa-solid fa-circle"></i>
                <span>Xử lý dữ liệu & Chuyển đổi số</span> <i class="fa-solid fa-circle"></i>
                <span>Hệ quản trị CMS & CRM</span> <i class="fa-solid fa-circle"></i>
                <!-- Duplicate for seamless loop -->
                <span>Phát triển phần mềm</span> <i class="fa-solid fa-circle"></i>
                <span>Tư vấn giải pháp CNTT</span> <i class="fa-solid fa-circle"></i>
                <span>Giải pháp thương mại điện tử</span> <i class="fa-solid fa-circle"></i>
                <span>Xây dựng ứng dụng di động</span> <i class="fa-solid fa-circle"></i>
                <span>Giải pháp đám mây</span> <i class="fa-solid fa-circle"></i>
                <span>Xây dựng website chuẩn SEO</span> <i class="fa-solid fa-circle"></i>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. SERVICES SECTION (FUTURISTIC SPOTLIGHT CARDS) -->
      <section class="tech-services-sec" id="services">
        <div class="container">
          <div class="tech-sec-header">
            <span class="tech-eyebrow"><i class="fa-solid fa-layer-group"></i> {servicesSec.subTitle}</span>
            <h2 class="tech-sec-title">{servicesSec.title} Công Nghệ Mũi Nhọn</h2>
            <p class="tech-sec-desc">{servicesSec.desc}</p>
          </div>

          <div class="tech-services-grid">
            {servicesSec.items.map((item, idx) => (
              <div class="tech-service-card">
                <div class="tsc-top-line"></div>
                <div class="tsc-header">
                  <div class="tsc-icon-hex">
                    <i class={item.icon}></i>
                  </div>
                  <span class="tsc-badge">{item.tag}</span>
                </div>

                <h3 class="tsc-title">{item.title}</h3>
                <p class="tsc-desc">{item.desc}</p>

                <div class="tsc-footer">
                  <a href="/lien-he" class="tsc-link">
                    <span>Tìm hiểu chi tiết</span>
                    <i class="fa-solid fa-arrow-right"></i>
                  </a>
                  <span class="tsc-num">0{idx + 1}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 4. ABOUT & TECH CAPABILITY SECTION (INTERACTIVE COMMAND CONSOLE) -->
      <section class="tech-about-sec" id="about">
        <div class="container">
          <div class="tech-sec-header">
            <span class="tech-eyebrow"><i class="fa-solid fa-bolt"></i> {about.subLabel}</span>
            <h2 class="tech-sec-title">{about.heading}</h2>
            <p class="tech-sec-desc">Hơn 16 năm đồng hành kiến tạo giải pháp phần mềm, chuyển đổi số toàn diện cho doanh nghiệp trong và ngoài nước.</p>
          </div>

          <div class="about-command-console">
            <!-- Left Visual Frame with HUD Overlay -->
            <div class="acc-photo-panel">
              <img src={about.teamImage} alt="Đội ngũ kỹ sư ABSoltech" loading="lazy" />
              <div class="acc-photo-hud">
                <div class="hud-badge-row">
                  <span class="hud-year"><i class="fa-solid fa-shield-halved"></i> EST. 2007</span>
                  <div class="hud-exp">
                    <strong>16+</strong> Năm Kinh Nghiệm Thực Chiến
                  </div>
                </div>
              </div>
            </div>

            <!-- Right Content Console -->
            <div class="acc-content-panel">
              <div>
                <div class="acc-tabs-bar">
                  <span class="acc-tab"> NĂNG LỰC CỐT LÕI & SỨ MỆNH</span>
                </div>

                <p class="acc-story-text">{about.content}</p>

                <div class="acc-pillars-row">
                  <div class="acc-pillar">
                    <div class="ap-icon"><i class="fa-solid fa-microchip"></i></div>
                    <div>
                      <strong>Làm chủ công nghệ</strong>
                      <span>AI, Cloud, ERP/CRM, Web & Mobile App hiện đại</span>
                    </div>
                  </div>
                  <div class="acc-pillar">
                    <div class="ap-icon"><i class="fa-solid fa-users-gear"></i></div>
                    <div>
                      <strong>Kỹ sư chuyên sâu</strong>
                      <span>Đội ngũ giàu kinh nghiệm dự án quốc tế</span>
                    </div>
                  </div>
                  <div class="acc-pillar">
                    <div class="ap-icon"><i class="fa-solid fa-headset"></i></div>
                    <div>
                      <strong>Đồng hành 24/7</strong>
                      <span>Cam kết tiến độ, bảo mật & hỗ trợ tận tâm</span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="acc-mission-banner">
                <i class="fa-solid fa-quote-left"></i>
                <span>“{about.quote}”</span>
              </div>
            </div>
          </div>

          <!-- Global Strategic Partners Strip -->
          <div class="about-global-strip">
            <div class="ags-left">
              <span class="ags-badge"><i class="fa-solid fa-earth-asia"></i> GLOBAL NETWORK</span>
              <h4>Đối Tác Chiến Lược Quốc Tế</h4>
              <p>Hợp tác phát triển phần mềm cùng các tập đoàn hàng đầu Nhật Bản, Hàn Quốc & Australia.</p>
            </div>
            <div class="ags-logos-row">
              {partners.map((p) => (
                <div class="ags-partner-pill">
                  <div class="ags-img-box">
                    <img src={p.logo} alt={p.name} loading="lazy" />
                  </div>
                  <span class="ags-p-name">{p.name}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 5. PACKAGED SOFTWARE SUITE (DARK GLASS TECH SECTION) -->
      <section class="tech-products-sec" id="products">
        <div class="cyber-grid-overlay"></div>
        <div class="container relative">
          <div class="tech-sec-header light">
            <span class="tech-eyebrow dark-mode"><i class="fa-solid fa-cubes"></i> {productsSec.subTitle}</span>
            <h2 class="tech-sec-title light">{productsSec.title}</h2>
            <p class="tech-sec-desc light">{productsSec.desc}</p>
          </div>

          <div class="tech-products-grid">
            {productsSec.items.map((p) => (
              <div class="tech-product-card">
                <div class="tpc-stage">
                  <span class="tpc-badge">{p.badge}</span>
                  <img src={p.image} alt={p.name} loading="lazy" />
                </div>
                <div class="tpc-body">
                  <div class="tpc-head-row">
                    <h3 class="tpc-name">{p.name}</h3>
                    <span class="tpc-status-dot" title="Sẵn sàng triển khai"></span>
                  </div>
                  <span class="tpc-tagline">{p.tagline}</span>
                  <p class="tpc-desc">{p.desc}</p>
                  <a href="/lien-he" class="tpc-btn">
                    <span>Yêu cầu Demo giải pháp</span>
                    <i class="fa-solid fa-arrow-right"></i>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 6. CLIENT TESTIMONIALS (INTERACTIVE SPOTLIGHT STAGE) -->
      <section class="tech-testimonials-sec" id="testimonials">
        <div class="container">
          <div class="tech-sec-header">
            <span class="tech-eyebrow"><i class="fa-solid fa-star"></i> ĐÁNH GIÁ TỪ KHÁCH HÀNG</span>
            <h2 class="tech-sec-title">Khách Hàng Nói Về Chúng Tôi</h2>
            <p class="tech-sec-desc">Niềm tin từ các doanh nghiệp trong nước và quốc tế qua hàng trăm dự án thực tế.</p>
          </div>

          <div class="testi-interactive-console">
            <!-- Left Client Selector List -->
            <div class="tic-client-list">
              {reviews.map((r, idx) => (
                <button
                  type="button"
                  class={`tic-client-btn ${idx === 0 ? 'active' : ''}`}
                  data-review-idx={idx}
                >
                  <div class="tic-avatar">{r.avatar}</div>
                  <div class="tic-meta">
                    <strong>{r.author}</strong>
                    <span>{r.role} • {r.company}</span>
                  </div>
                  <i class="fa-solid fa-chevron-right tic-arrow"></i>
                </button>
              ))}
            </div>

            <!-- Right Spotlight Quote Stage -->
            <div class="tic-spotlight-stage">
              {reviews.map((r, idx) => (
                <div
                  class={`tic-spotlight-panel ${idx === 0 ? 'active' : ''}`}
                  data-review-panel={idx}
                >
                  <div class="tsp-top-bar">
                    <span class="tsp-verified">
                      <i class="fa-solid fa-circle-check"></i> ĐỐI TÁC XÁC THỰC QUỐC TẾ
                    </span>
                    <div class="tsp-stars">
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                      <span>5.0 / 5.0</span>
                    </div>
                  </div>

                  <div class="tsp-quote-body">
                    <i class="fa-solid fa-quote-left tsp-bg-quote"></i>
                    <p>“{r.quote}”</p>
                  </div>

                  <div class="tsp-footer">
                    <div class="tsp-author-box">
                      <div class="tsp-lg-avatar">{r.avatar}</div>
                      <div>
                        <h4>{r.author}</h4>
                        <span>{r.role} tại <strong>{r.company}</strong></span>
                      </div>
                    </div>
                    <div class="tsp-project-tag">
                      <i class="fa-solid fa-code-branch"></i>
                      <span>Dự án Phần mềm & Nền tảng số</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 7. DIGITAL TRANSFORMATION CALLOUT -->
      <section class="tech-callout-sec">
        <div class="container">
          <div class="tech-callout-box">
            <div class="tcb-glow"></div>
            <div class="tcb-text">
              <span class="tcb-tag"><i class="fa-solid fa-wand-magic-sparkles"></i> TƯ VẤN CHUYỂN ĐỔI SỐ TOÀN DIỆN</span>
              <h2>{callout.title}</h2>
              <p>{callout.desc}</p>
            </div>
            <div class="tcb-actions">
              <a href={`tel:${callout.phone.replace(/\s+/g, '')}`} class="btn-tcb-phone">
                <div class="tcb-phone-icon"><i class="fa-solid fa-phone-volume"></i></div>
                <div class="tcb-phone-meta">
                  <span>Hotline chuyên gia</span>
                  <strong>{callout.phone}</strong>
                </div>
              </a>
              <a href="/lien-he" class="btn-tcb-primary">
                <span>Nhận tư vấn miễn phí</span>
                <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- 8. FOOTER -->
    <footer class="tech-footer">
      <div class="container">
        <div class="tech-footer-grid">
          <!-- Left Brand Blue Card (keeps logo clearly visible) -->
          <div class="tf-brand-panel">
            <img src="https://absoltech.vn/wp-content/uploads/2025/08/logo_dark_h400-768x132.png" alt="ABSoltech Logo" class="tf-logo" />
            <h3 class="tf-company">CÔNG TY CỔ PHẦN PHẦN MỀM AN BIÊN</h3>
            <p class="tf-legal">MSDN: 0200838952 cấp ngày 07/11/2009 tại Sở KH&ĐT TP. Hải Phòng</p>

            <div class="tf-addresses">
              <div class="tfa-row">
                <i class="fa-solid fa-building"></i>
                <div>
                  <strong>VPGD Hải Phòng:</strong> Tầng 4, 22 Lý Tự Trọng, Hồng Bàng, Hải Phòng
                </div>
              </div>
              <div class="tfa-row">
                <i class="fa-solid fa-location-dot"></i>
                <div>
                  <strong>Hà Nội:</strong> Số 4, LK4 - TT1, 96-96B Nguyễn Huy Tưởng, Thanh Xuân, Hà Nội
                </div>
              </div>
              <div class="tfa-row">
                <i class="fa-solid fa-location-dot"></i>
                <div>
                  <strong>TP. Hồ Chí Minh:</strong> 383 Nguyễn Duy Trinh, Bình Trưng Tây, TP. Thủ Đức, TP.HCM
                </div>
              </div>
              <div class="tfa-row">
                <i class="fa-solid fa-location-dot"></i>
                <div>
                  <strong>Thanh Hóa:</strong> 11 Cửa Hữu, Phường Tân Sơn, TP. Thanh Hóa
                </div>
