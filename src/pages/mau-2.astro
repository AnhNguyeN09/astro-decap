---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FloatingContact from '../components/FloatingContact.astro';

// Lấy dữ liệu thực từ Decap CMS
const homeEntry = await getEntry('homepage', 'index');
const homeData = homeEntry?.data;

const slides = homeData?.slides || [];
const about = homeData?.about || {
  heading: "Xây dựng Phần Mềm & Thiết Kế Website Chuyên Nghiệp",
  subLabel: "VỀ ABSOLTECH",
  content: "Thành lập tháng 12 năm 2007 - ABSoltech trải qua hơn 16 năm phát triển, chúng tôi đã trở thành thương hiệu doanh nghiệp CNTT hàng đầu tại khu vực Duyên Hải.",
  quote: "Sứ mệnh của chúng tôi là mang đến giá trị thặng dư lớn và sự thành công cho khách hàng",
  teamImage: "https://absoltech.vn/wp-content/uploads/2023/09/teamworks-absoltech-1024x683.jpg"
};
const servicesSec = homeData?.servicesSection || {
  subTitle: "CÁC DỊCH VỤ MÀ ABSOLTECH CUNG CẤP",
  title: "Dịch Vụ",
  desc: "Giải pháp công nghệ toàn diện nâng tầm doanh nghiệp trong kỷ nguyên số.",
  items: []
};
const productsSec = homeData?.productsSection || {
  subTitle: "SẢN PHẨM",
  title: "Phần Mềm Đóng Gói",
  desc: "Hệ sinh thái phần mềm đóng gói giải quyết triệt để bài toán vận hành của từng ngành nghề.",
  items: []
};
const callout = homeData?.callout || {
  title: "Bạn đang quan tâm tới chuyển đổi số?",
  desc: "Với kinh nghiệm hơn 20 năm triển khai ứng dụng CNTT trong nhiều lĩnh vực, các chuyên gia của chúng tôi sẽ đưa ra giải pháp tốt nhất cho doanh nghiệp của bạn",
  phone: "0985 18 5665"
};

const reviews = [
  {
    author: "Mr. David Henry",
    company: "DHM Digital",
    role: "CEO & Founder",
    quote: "Đội ngũ chuyên nghiệp dẫn đầu bởi Mr Công. Nhân ngày kỉ niệm 10 năm thành lập, các bạn đã luôn làm rất tốt. Hãy tiếp tục giữ vững tinh thần và hoàn thành tốt công việc nhé.",
    avatar: "DH"
  },
  {
    author: "Ms. Renae Christine",
    company: "OWHO",
    role: "Product Director",
    quote: "Những lập trình viên bậc A++, giao tiếp rất tốt. Họ vô cùng hữu ích và luôn túc trực sẵn sàng xử lý vấn đề, sự cố khẩn cấp cho bạn.",
    avatar: "RC"
  },
  {
    author: "Mr. Blake Bridge",
    company: "Room Connection",
    role: "Managing Partner",
    quote: "Tôi đã làm việc với ABSoft trong gần 2 năm để phát triển ứng dụng, trang web và nền tảng của mình. Họ là những người giỏi nhất trong công việc này. Giao tiếp hiệu quả, phản hồi nhanh chóng.",
    avatar: "BB"
  },
  {
    author: "Mr. Scott Price",
    company: "Marketing Solution",
    role: "Technical Lead",
    quote: "Chắc chắn là 1 công ty tuyệt vời rồi. Tôi đã hợp tác với Công và đội ngũ của anh ấy cho rất nhiều dự án và sẽ thêm nhiều dự án hơn nữa trong tương lai.",
    avatar: "SP"
  }
];

const partners = [
  { name: "SoftBank", desc: "Viễn thông & Công nghệ", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-softbank.png" },
  { name: "Bijin-Tokei", desc: "Truyền thông & Giải trí số", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-bijint.png" },
  { name: "World Air Plan", desc: "Du lịch & Hàng không", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-wap.png" },
  { name: "CyberAgent", desc: "Internet & Quảng cáo số", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-cyberagent.png" }
];

const stats = [
  { number: "05", suffix: "", label: "Quốc gia triển khai", icon: "fa-solid fa-earth-asia", sub: "Nhật Bản, Hàn Quốc, Úc..." },
  { number: "20", suffix: "+", label: "Đối tác chiến lược", icon: "fa-solid fa-handshake-simple", sub: "Tập đoàn công nghệ lớn" },
  { number: "500", suffix: "+", label: "Dự án hoàn thành", icon: "fa-solid fa-microchip", sub: "Phần mềm, ERP, Web & App" },
  { number: "1000", suffix: "+", label: "Khách hàng tin dùng", icon: "fa-solid fa-building-shield", sub: "Doanh nghiệp trong & ngoài nước" }
];
---

<Layout>
  <div class="cyber-dark-page">
    <!-- 1. CHUẨN HEADER 3 CẤP TỪ HEADER.ASTRO -->
    <Header />

    <main>
      <!-- 2. CENTERED WIDESCREEN HERO + COCKPIT MOCKUP (KHÔNG CHIA 2 CỘT TRÁI-PHẢI) -->
      <section class="cd-hero-sec">
        <div class="cd-matrix-bg"></div>
        <div class="cd-aura-top"></div>

        <div class="container relative">
          <!-- Slide Selector Tabs on Top -->
          <div class="cd-hero-switcher">
            {slides.map((s, idx) => (
              <button
                type="button"
                class={`cd-switch-pill ${idx === 0 ? 'active' : ''}`}
                data-cd-slide={idx}
              >
                <span class="csp-dot"></span>
                <span>{s.title}</span>
              </button>
            ))}
          </div>

          <div class="cd-slides-stage">
            {slides.map((s, idx) => (
              <div class={`cd-hero-slide ${idx === 0 ? 'active' : ''}`} data-cd-panel={idx}>
                <!-- Centered Editorial Headline -->
                <div class="cd-hero-center">
                  <span class="cd-pre-title">{s.pretitle}</span>
                  <h1 class="cd-main-title">{s.title}</h1>
                  <p class="cd-hero-desc">{s.description}</p>

                  <div class="cd-hero-cta">
                    <a href={s.btnPrimaryLink || '/lien-he'} class="btn-cd-glow">
                      <span>{s.btnPrimaryText || 'Khởi tạo dự án ngay'}</span>
                      <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <a href={s.btnSecondaryLink || '#products'} class="btn-cd-glass">
                      <i class="fa-solid fa-cubes"></i>
                      <span>Trải nghiệm Hệ sinh thái Phần mềm</span>
                    </a>
                  </div>
                </div>

                <!-- Widescreen 3D Cockpit Browser Frame + Side KPI Pods -->
                <div class="cd-cockpit-grid">
                  <!-- Left Telemetry Pod -->
                  <div class="cd-side-pods">
                    {stats.slice(0, 2).map((st) => (
                      <div class="cd-kpi-pod">
                        <div class="ckp-icon"><i class={st.icon}></i></div>
                        <div class="ckp-num">{st.number}<span>{st.suffix}</span></div>
                        <strong>{st.label}</strong>
                        <p>{st.sub}</p>
                      </div>
                    ))}
                  </div>

                  <!-- Center Widescreen Browser Window -->
                  <div class="cd-browser-frame">
                    <div class="cbf-toolbar">
                      <div class="cbf-dots"><span></span><span></span><span></span></div>
                      <div class="cbf-url"><i class="fa-solid fa-lock"></i> absoltech.vn / {s.title.toLowerCase()}</div>
                      <div class="cbf-status"><span class="live-pulse"></span> ONLINE</div>
                    </div>
                    <div class="cbf-viewport">
                      <img src={s.image} alt={s.title} />
                    </div>
                  </div>

                  <!-- Right Telemetry Pod -->
                  <div class="cd-side-pods">
                    {stats.slice(2, 4).map((st) => (
                      <div class="cd-kpi-pod">
                        <div class="ckp-icon"><i class={st.icon}></i></div>
                        <div class="ckp-num">{st.number}<span>{st.suffix}</span></div>
                        <strong>{st.label}</strong>
                        <p>{st.sub}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Full-bleed Neon Marquee Ribbon -->
        <div class="cd-neon-marquee">
          <div class="cnm-track">
            <span><i class="fa-solid fa-bolt"></i> Phát triển phần mềm</span>
            <span><i class="fa-solid fa-bolt"></i> Tư vấn giải pháp CNTT</span>
            <span><i class="fa-solid fa-bolt"></i> Giải pháp thương mại điện tử</span>
            <span><i class="fa-solid fa-bolt"></i> Xây dựng ứng dụng di động</span>
            <span><i class="fa-solid fa-bolt"></i> Giải pháp đám mây</span>
            <span><i class="fa-solid fa-bolt"></i> Xây dựng website chuẩn SEO</span>
            <span><i class="fa-solid fa-bolt"></i> Xử lý dữ liệu & Chuyển đổi số</span>
            <span><i class="fa-solid fa-bolt"></i> Hệ quản trị CMS & CRM</span>
            <!-- Duplicate -->
            <span><i class="fa-solid fa-bolt"></i> Phát triển phần mềm</span>
            <span><i class="fa-solid fa-bolt"></i> Tư vấn giải pháp CNTT</span>
            <span><i class="fa-solid fa-bolt"></i> Giải pháp thương mại điện tử</span>
            <span><i class="fa-solid fa-bolt"></i> Xây dựng ứng dụng di động</span>
            <span><i class="fa-solid fa-bolt"></i> Giải pháp đám mây</span>
            <span><i class="fa-solid fa-bolt"></i> Xây dựng website chuẩn SEO</span>
          </div>
        </div>
      </section>

      <!-- 3. INTERACTIVE PRODUCT APP WORKSPACE (ĐƯA LÊN TRƯỚC, DẠNG BỘ CHUYỂN ĐỔI TAB ỨNG DỤNG) -->
      <section class="cd-workspace-sec" id="products">
        <div class="container">
          <div class="cd-sec-head">
            <span class="cd-tag"><i class="fa-solid fa-layer-group"></i> {productsSec.subTitle}</span>
            <h2>{productsSec.title} — Trải Nghiệm Trực Quan</h2>
            <p>{productsSec.desc}</p>
          </div>

          <div class="cd-app-explorer">
            <!-- Top App Dock Tabs -->
            <div class="cae-dock">
              {productsSec.items.map((p, idx) => (
                <button
                  type="button"
                  class={`cae-tab-btn ${idx === 0 ? 'active' : ''}`}
                  data-app-idx={idx}
                >
                  <span class="ctb-name">{p.name}</span>
                  <small class="ctb-badge">{p.badge}</small>
                </button>
              ))}
            </div>

            <!-- Main App Stage Window -->
            <div class="cae-stage">
              {productsSec.items.map((p, idx) => (
                <div class={`cae-panel ${idx === 0 ? 'active' : ''}`} data-app-panel={idx}>
                  <div class="cae-panel-info">
                    <div class="cpi-badge-row">
                      <span class="cpi-badge">{p.badge}</span>
                      <span class="cpi-ready"><i class="fa-solid fa-circle-check"></i> Sẵn sàng triển khai Cloud / On-Premise</span>
                    </div>
                    <h3>{p.name}</h3>
                    <strong class="cpi-tagline">{p.tagline}</strong>
                    <p class="cpi-desc">{p.desc}</p>

                    <div class="cpi-features">
                      <div><i class="fa-solid fa-gauge-high"></i> Tối ưu hóa quy trình vận hành thực tế</div>
                      <div><i class="fa-solid fa-lock"></i> Phân quyền bảo mật đa tầng & Sao lưu tự động</div>
                      <div><i class="fa-solid fa-mobile-screen-button"></i> Đa nền tảng: Web, Tablet & Smartphone</div>
                    </div>

                    <div class="cpi-actions">
                      <a href="/lien-he" class="btn-cd-glow">
                        <span>Đăng ký dùng thử {p.name}</span>
                        <i class="fa-solid fa-arrow-right"></i>
                      </a>
                      <a href="tel:0985185665" class="btn-cd-glass">
                        <i class="fa-solid fa-phone"></i>
                        <span>Tư vấn kỹ thuật</span>
                      </a>
                    </div>
                  </div>

                  <div class="cae-panel-screen">
                    <div class="cps-window">
                      <img src={p.image} alt={p.name} loading="lazy" />
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 4. SPLIT-SCREEN SERVICES (CỘT TRÁI ĐẦY ĐẶN CÂN XỨNG VỚI LƯỚI 2x3 BÊN PHẢI) -->
      <section class="cd-services-split-sec" id="services">
        <div class="container">
          <div class="cd-split-layout">
            <!-- Left Full-Height Feature Column -->
            <div class="cd-split-left">
              <div class="csl-feature-panel">
                <div class="csl-top-intro">
                  <span class="cd-tag light-tag"><i class="fa-solid fa-wand-magic-sparkles"></i> {servicesSec.subTitle}</span>
                  <h2>{servicesSec.title} Công Nghệ Toàn Diện</h2>
                  <p>{servicesSec.desc}</p>
                </div>

                <!-- 4 Bước Quy Trình Triển Khai Chuẩn Quốc Tế (Lấp đầy khoảng trống cột trái) -->
                <div class="csl-workflow-box">
                  <span class="cwb-title"><i class="fa-solid fa-diagram-project"></i> QUY TRÌNH TRIỂN KHAI CHUẨN QUỐC TẾ</span>
                  <div class="cwb-steps">
                    <div class="cwb-step">
                      <span class="cwbs-num">01</span>
                      <div>
                        <strong>Khảo sát & Phân tích nghiệp vụ</strong>
                        <span>Đánh giá bài toán thực tế & tư vấn kiến trúc tối ưu</span>
                      </div>
                    </div>
                    <div class="cwb-step">
                      <span class="cwbs-num">02</span>
                      <div>
                        <strong>Thiết kế UI/UX & Phát triển Agile</strong>
                        <span>Xây dựng giao diện trực quan & lập trình theo Sprint</span>
                      </div>
                    </div>
                    <div class="cwb-step">
                      <span class="cwbs-num">03</span>
                      <div>
                        <strong>Kiểm thử QA & Bảo mật đa tầng</strong>
                        <span>Đảm bảo hiệu năng cao, chịu tải lớn & an toàn dữ liệu</span>
                      </div>
                    </div>
                    <div class="cwb-step">
                      <span class="cwbs-num">04</span>
                      <div>
                        <strong>Chuyển giao & Đồng hành 24/7</strong>
                        <span>Đào tạo vận hành, bảo hành & nâng cấp dài hạn</span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Bottom CTA Card -->
                <div class="csl-highlight-card">
                  <div class="chc-row">
                    <i class="fa-solid fa-headset"></i>
                    <div>
                      <strong>Tư vấn kiến trúc hệ thống 1:1</strong>
                      <span>Khảo sát bài toán và đề xuất giải pháp tối ưu chi phí cho từng doanh nghiệp.</span>
                    </div>
                  </div>
                  <a href="/lien-he" class="btn-cd-glow full-w">
                    <span>Nhận báo giá & Giải pháp</span>
                    <i class="fa-solid fa-arrow-right"></i>
                  </a>
                </div>
              </div>
            </div>

            <!-- Right 2-Column Compact Grid -->
            <div class="cd-split-right-grid">
              {servicesSec.items.map((item) => (
                <div class="cd-service-stream-card">
                  <div class="cssc-head-row">
                    <div class="cssc-icon">
                      <i class={item.icon}></i>
                    </div>
                    <span class="cssc-tag">{item.tag}</span>
                  </div>
                  <h3>{item.title}</h3>
                  <p>{item.desc}</p>
                  <a href="/lien-he" class="cssc-link">
                    <span>Tư vấn giải pháp</span>
                    <i class="fa-solid fa-arrow-right"></i>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 5. ABOUT ABSOLTECH: PANORAMIC BANNER + FLOATING CONSOLE (LOGO ĐỐI TÁC TO RÕ, BỎ CHỮ THỪA) -->
      <section class="cd-about-sec" id="about">
        <div class="container">
          <div class="cd-panoramic-about">
            <!-- Full-width Team Photo Backdrop -->
            <div class="cpa-backdrop">
              <img src={about.teamImage} alt="Đội ngũ ABSoltech" loading="lazy" />
              <div class="cpa-overlay"></div>
              <div class="cpa-caption">
                <span class="cd-tag"><i class="fa-solid fa-building-shield"></i> {about.subLabel}</span>
                <h2>{about.heading}</h2>
              </div>
            </div>

            <!-- Overlapping Console -->
            <div class="cpa-glass-console">
              <div class="cgc-story">
                <p class="cgc-text">{about.content}</p>
                <div class="cgc-quote">
                  <i class="fa-solid fa-quote-left"></i>
                  <span>“{about.quote}”</span>
                </div>
              </div>

              <div class="cgc-partners">
                <div class="cgcp-head">
                  <span><i class="fa-solid fa-earth-asia"></i> ĐỐI TÁC QUỐC TẾ TIÊU BIỂU</span>
                  <small>Nhật Bản • Hàn Quốc • Australia</small>
                </div>
                <div class="cgcp-logos">
                  {partners.map((p) => (
                    <div class="cgcp-logo-card" title={p.name}>
                      <img src={p.logo} alt={p.name} loading="lazy" />
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 6. CLIENT TESTIMONIALS: SPOTLIGHT INTERACTIVE CONSOLE -->
      <section class="cd-testimonials-sec" id="testimonials">
        <div class="container">
          <div class="cd-sec-head light-head">
            <span class="cd-tag light-tag"><i class="fa-solid fa-star"></i> ĐÁNH GIÁ TỪ KHÁCH HÀNG</span>
            <h2>Khách Hàng Quốc Tế Nói Về Chúng Tôi</h2>
            <p>Sự hài lòng của đối tác là thước đo chính xác nhất cho năng lực kỹ thuật của ABSoltech.</p>
          </div>

          <div class="cd-testi-stage">
            <div class="cts-selector">
              {reviews.map((r, idx) => (
                <button
                  type="button"
                  class={`cts-btn ${idx === 0 ? 'active' : ''}`}
                  data-cts-idx={idx}
                >
                  <div class="cts-avatar">{r.avatar}</div>
                  <div class="cts-meta">
                    <strong>{r.author}</strong>
                    <span>{r.role} • {r.company}</span>
                  </div>
                </button>
              ))}
            </div>

            <div class="cts-display">
              {reviews.map((r, idx) => (
                <div class={`cts-quote-box ${idx === 0 ? 'active' : ''}`} data-cts-panel={idx}>
                  <div class="cqb-top">
                    <div class="cqb-stars">
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                      <span>5.0 / 5.0</span>
                    </div>
                    <span class="cqb-verified"><i class="fa-solid fa-shield-check"></i> ĐỐI TÁC QUỐC TẾ</span>
                  </div>
                  <blockquote>“{r.quote}”</blockquote>
                  <div class="cqb-author">
                    <strong>{r.author}</strong>
                    <span>{r.role} — {r.company}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- 7. FULL-WIDTH HORIZONTAL CONSULTATION HUB + 4-COLUMN SAAS FOOTER (KHÁC HẲN MẪU 1) -->
    <footer class="cd-footer">
      <div class="container">
        <!-- Top Horizontal Consultation Dock -->
        <div class="cd-consult-dock">
          <div class="ccd-intro">
            <span class="cd-tag"><i class="fa-solid fa-bolt"></i> KẾT NỐI CHUYÊN GIA 24/7</span>
            <h3>{callout.title}</h3>
            <p>{callout.desc}</p>
            <div class="ccd-hotline-bar">
              <a href={`tel:${callout.phone.replace(/\s+/g, '')}`} class="btn-cd-phone">
                <i class="fa-solid fa-phone-volume"></i>
                <div>
                  <small>Hotline tư vấn trực tiếp</small>
                  <strong>{callout.phone}</strong>
                </div>
              </a>
              <a href="mailto:contact@absoltech.vn" class="btn-cd-mail">
                <i class="fa-regular fa-envelope"></i>
                <span>contact@absoltech.vn</span>
              </a>
            </div>
          </div>

          <form class="ccd-inline-form" onsubmit="event.preventDefault(); alert('Cảm ơn bạn đã liên hệ ABSoltech! Chúng tôi sẽ phản hồi sớm nhất.');">
            <div class="ccdif-grid">
              <input type="text" placeholder="Họ và tên của bạn *" required />
              <input type="tel" placeholder="Số điện thoại *" required />
              <input type="email" placeholder="Email doanh nghiệp *" required />
              <input type="text" placeholder="Tên công ty / Đơn vị" />
            </div>
            <div class="ccdif-bottom">
              <input type="text" placeholder="Nhu cầu tư vấn (Phần mềm, Website, App, ERP/CRM...)" required />
            </div>
            <button type="submit" class="btn-cd-glow">
                <span>Gửi yêu cầu ngay</span>
                <i class="fa-solid fa-paper-plane"></i>
              </button>
          </form>
        </div>

        <!-- 4-Column Office & Brand Architecture -->
        <div class="cd-footer-cols">
          <div class="cdf-col brand-col">
            <div class="cdf-logo-pill">
              <img src="https://absoltech.vn/wp-content/uploads/2025/08/logo_dark_h400-768x132.png" alt="ABSoltech Logo" />
            </div>
