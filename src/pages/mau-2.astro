<script>
  let curTechSlide = 0;
  const techSlides = document.querySelectorAll('.tech-slide');
  const totalTechSlides = techSlides.length;

  function setTechSlide(index: number) {
    if (totalTechSlides === 0) return;
    curTechSlide = (index + totalTechSlides) % totalTechSlides;
    techSlides.forEach((s, i) => {
      s.classList.toggle('active', i === curTechSlide);
    });
  }

  document.querySelectorAll('.t-arrow').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dir = btn.getAttribute('data-dir');
      setTechSlide(dir === 'next' ? curTechSlide + 1 : curTechSlide - 1);
    });
  });

  document.querySelectorAll('.t-dot').forEach((dot) => {
    dot.addEventListener('click', () => {
      const idx = Number(dot.getAttribute('data-go') || 0);
      setTechSlide(idx);
    });
  });

  setInterval(() => {
    setTechSlide(curTechSlide + 1);
  }, 6000);

  // Interactive Testimonial Spotlight Switcher
  const clientBtns = document.querySelectorAll('.tic-client-btn');
  const reviewPanels = document.querySelectorAll('.tic-spotlight-panel');

  clientBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.getAttribute('data-review-idx');
      clientBtns.forEach((b) => b.classList.remove('active'));
      reviewPanels.forEach((p) => p.classList.remove('active'));

      btn.classList.add('active');
      document.querySelector(`.tic-spotlight-panel[data-review-panel="${idx}"]`)?.classList.add('active');
    });
  });
</script>

