<script>
  // 1. Hero Widescreen Switcher
  const cdSwitchBtns = document.querySelectorAll('.cd-switch-pill');
  const cdHeroPanels = document.querySelectorAll('.cd-hero-slide');

  cdSwitchBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.getAttribute('data-cd-slide');
      cdSwitchBtns.forEach((b) => b.classList.remove('active'));
      cdHeroPanels.forEach((p) => p.classList.remove('active'));
      btn.classList.add('active');
      document.querySelector(`.cd-hero-slide[data-cd-panel="${idx}"]`)?.classList.add('active');
    });
  });

  // 2. Interactive Product App Workspace Switcher
  const appTabBtns = document.querySelectorAll('.cae-tab-btn');
  const appPanels = document.querySelectorAll('.cae-panel');

  appTabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.getAttribute('data-app-idx');
      appTabBtns.forEach((b) => b.classList.remove('active'));
      appPanels.forEach((p) => p.classList.remove('active'));
      btn.classList.add('active');
      document.querySelector(`.cae-panel[data-app-panel="${idx}"]`)?.classList.add('active');
    });
  });

  // 3. Testimonial Spotlight Switcher
  const ctsBtns = document.querySelectorAll('.cts-btn');
  const ctsPanels = document.querySelectorAll('.cts-quote-box');

  ctsBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.getAttribute('data-cts-idx');
      ctsBtns.forEach((b) => b.classList.remove('active'));
      ctsPanels.forEach((p) => p.classList.remove('active'));
      btn.classList.add('active');
      document.querySelector(`.cts-quote-box[data-cts-panel="${idx}"]`)?.classList.add('active');
    });
  });
</script>
