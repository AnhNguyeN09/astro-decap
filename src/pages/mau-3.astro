<script>
  // 1. Hero Interactive Dock Cards Switcher
  const acDockBtns = document.querySelectorAll('.ac-dock-card');
  const acHeroPanels = document.querySelectorAll('.ac-hero-main');

  acDockBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.getAttribute('data-ac-trigger');
      acDockBtns.forEach((b) => b.classList.remove('active'));
      acHeroPanels.forEach((p) => p.classList.remove('active'));
      btn.classList.add('active');
      document.querySelector(`.ac-hero-main[data-ac-panel="${idx}"]`)?.classList.add('active');
    });
  });

  // 2. Service Accordion Studio Switcher
  const srvAccItems = document.querySelectorAll('.ass-acc-item');
  const srvSpotPanels = document.querySelectorAll('.ass-spot-card');

  srvAccItems.forEach((item) => {
    item.addEventListener('click', () => {
      const idx = item.getAttribute('data-srv-trigger');
      srvAccItems.forEach((i) => i.classList.remove('active'));
      srvSpotPanels.forEach((p) => p.classList.remove('active'));
      item.classList.add('active');
      document.querySelector(`.ass-spot-card[data-srv-panel="${idx}"]`)?.classList.add('active');
    });
  });

  // 3. Testimonials Top Avatar Pills Switcher
  const testiPills = document.querySelectorAll('.act-person-pill');
  const testiStages = document.querySelectorAll('.act-featured-stage');

  testiPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const idx = pill.getAttribute('data-testi-trigger');
      testiPills.forEach((p) => p.classList.remove('active'));
      testiStages.forEach((s) => s.classList.remove('active'));
      pill.classList.add('active');
      document.querySelector(`.act-featured-stage[data-testi-panel="${idx}"]`)?.classList.add('active');
    });
  });
</script>
