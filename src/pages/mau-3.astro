---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FloatingContact from '../components/FloatingContact.astro';

// Lấy dữ liệu thực từ Decap CMS
const homeEntry = await getEntry('homepage', 'index');
const homeData = homeEntry?.data;

const slides = homeData?.slides || [];
const about = homeData?.about || {
  heading: "Xây dựng Phần Mềm & Thiết Kế Website Chuyên Nghiệp",
  subLabel: "VỀ ABSOLTECH",
  content: "Thành lập tháng 12 năm 2007 - ABSoltech trải qua hơn 16 năm phát triển, chúng tôi đã trở thành thương hiệu doanh nghiệp CNTT hàng đầu tại khu vực Duyên Hải.",
  quote: "Sứ mệnh của chúng tôi là mang đến giá trị thặng dư lớn và sự thành công cho khách hàng",
  teamImage: "https://absoltech.vn/wp-content/uploads/2023/09/teamworks-absoltech-1024x683.jpg"
};
const servicesSec = homeData?.servicesSection || {
  subTitle: "CÁC DỊCH VỤ MÀ ABSOLTECH CUNG CẤP",
  title: "Dịch Vụ",
  desc: "Giải pháp công nghệ toàn diện nâng tầm doanh nghiệp trong kỷ nguyên số.",
  items: []
};
const productsSec = homeData?.productsSection || {
  subTitle: "SẢN PHẨM",
  title: "Phần Mềm Đóng Gói",
  desc: "Hệ sinh thái phần mềm đóng gói giải quyết triệt để bài toán vận hành của từng ngành nghề.",
  items: []
};
const callout = homeData?.callout || {
  title: "Bạn đang quan tâm tới chuyển đổi số?",
  desc: "Với kinh nghiệm hơn 20 năm triển khai ứng dụng CNTT trong nhiều lĩnh vực, các chuyên gia của chúng tôi sẽ đưa ra giải pháp tốt nhất cho doanh nghiệp của bạn",
  phone: "0985 18 5665"
};

const reviews = [
  {
    country: "Đối tác Quốc tế",
    projectType: "Phát triển Website & Nền tảng số",
    author: "Mr. David Henry",
    company: "DHM Digital",
    role: "CEO & Founder",
    quote: "Đội ngũ chuyên nghiệp dẫn đầu bởi Mr Công. Nhân ngày kỉ niệm 10 năm thành lập, các bạn đã luôn làm rất tốt. Hãy tiếp tục giữ vững tinh thần và hoàn thành tốt công việc nhé.",
    avatar: "DH"
  },
  {
    country: "Khách hàng Quốc tế",
    projectType: "Vận hành & Phát triển hệ thống 24/7",
    author: "Ms. Renae Christine",
    company: "OWHO",
    role: "Product Director",
    quote: "Những lập trình viên bậc A++, giao tiếp rất tốt. Họ vô cùng hữu ích và luôn túc trực sẵn sàng xử lý vấn đề, sự cố khẩn cấp cho bạn.",
    avatar: "RC"
  },
  {
    country: "Hợp tác Dài hạn",
    projectType: "Ứng dụng Di động & Nền tảng Cloud",
    author: "Mr. Blake Bridge",
    company: "Room Connection",
    role: "Managing Partner",
    quote: "Tôi đã làm việc với ABSoft trong gần 2 năm để phát triển ứng dụng, trang web và nền tảng của mình. Họ là những người giỏi nhất trong công việc này. Giao tiếp hiệu quả, phản hồi nhanh chóng.",
    avatar: "BB"
  },
  {
    country: "Đối tác Chiến lược",
    projectType: "Giải pháp Phần mềm Doanh nghiệp",
    author: "Mr. Scott Price",
    company: "Marketing Solution",
    role: "Technical Lead",
    quote: "Chắc chắn là 1 công ty tuyệt vời rồi. Tôi đã hợp tác với Công và đội ngũ của anh ấy cho rất nhiều dự án và sẽ thêm nhiều dự án hơn nữa trong tương lai.",
    avatar: "SP"
  }
];

const partners = [
  { name: "SoftBank", region: "Nhật Bản", desc: "Tập đoàn Viễn thông & Công nghệ hàng đầu Nhật Bản", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-softbank.png" },
  { name: "Bijin-Tokei", region: "Nhật Bản", desc: "Nền tảng Truyền thông & Giải trí số sáng tạo", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-bijint.png" },
  { name: "World Air Plan", region: "Nhật Bản", desc: "Hệ thống Đặt vé, Du lịch & Hàng không quốc tế", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-wap.png" },
  { name: "CyberAgent", region: "Nhật Bản", desc: "Tập đoàn Internet, Game & Quảng cáo kỹ thuật số", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-cyberagent.png" }
];

const stats = [
  { number: "05", suffix: "", label: "Quốc gia triển khai", sub: "Nhật Bản, Hàn Quốc, Australia..." },
  { number: "20", suffix: "+", label: "Đối tác chiến lược", sub: "Tập đoàn công nghệ quốc tế" },
  { number: "500", suffix: "+", label: "Dự án hoàn thành", sub: "Phần mềm, ERP, Web & Mobile" },
  { number: "1000", suffix: "+", label: "Khách hàng tin dùng", sub: "Doanh nghiệp trong & ngoài nước" }
];

const milestones = [
  { year: "2007", title: "Thành lập thương hiệu", desc: "Khởi đầu hành trình xây dựng phần mềm chuyên nghiệp tại Hải Phòng." },
  { year: "2014", title: "Vươn tầm quốc tế", desc: "Trở thành đối tác phát triển phần mềm cho các doanh nghiệp Nhật Bản, Úc." },
  { year: "2019", title: "Mở rộng toàn quốc", desc: "Hiện diện văn phòng tại Hải Phòng, Hà Nội, TP.HCM và Thanh Hóa." },
  { year: "2026", title: "Hệ sinh thái chuyển đổi số", desc: "Làm chủ AI, Cloud, ERP/CRM phục vụ hơn 1000+ doanh nghiệp." }
];
---

<Layout>
  <div class="jp-enterprise-wrapper">
    <!-- 1. CHUẨN HEADER 3 CẤP TỪ HEADER.ASTRO -->
    <Header />

    <main>
      <!-- 2. JAPANESE CORPORATE ARCHITECTURAL HERO -->
      <section class="jp-hero-sec">
        <div class="jp-architectural-lines">
          <span></span><span></span><span></span><span></span>
        </div>

        <div class="container relative">
          <div class="jp-hero-slider">
            {slides.map((slide, idx) => (
              <div class={`jp-slide ${idx === 0 ? 'active' : ''}`} data-jp-slide={idx}>
                <div class="jp-hero-grid">
                  <!-- Left Editorial Column -->
                  <div class="jp-hero-left">
                    <div class="jp-serial-bar">
                      <span class="jp-serial-line"></span>
                      <span class="jp-serial-tag">GIẢI PHÁP CÔNG NGHỆ TOÀN DIỆN</span>
                    </div>

                    <h1 class="jp-hero-title">
                      <span class="jp-pre">{slide.pretitle}</span>
                      <span class="jp-main">{slide.title}</span>
                    </h1>

                    <p class="jp-hero-desc">{slide.description}</p>

                    <div class="jp-hero-actions">
                      <a href={slide.btnPrimaryLink || '/lien-he'} class="btn-jp-primary">
                        <span>{slide.btnPrimaryText || 'Liên hệ tư vấn giải pháp'}</span>
                        <i class="fa-solid fa-arrow-right"></i>
                      </a>
                      <a href={slide.btnSecondaryLink || '/du-an'} class="btn-jp-outline">
                        <span>{slide.btnSecondaryText || 'Hồ sơ năng lực & Dự án'}</span>
                      </a>
                    </div>

                    <div class="jp-slider-nav">
                      <button type="button" class="jp-arrow" data-jp-dir="prev" aria-label="Slide trước">
                        <i class="fa-solid fa-arrow-left"></i>
                      </button>
                      <div class="jp-dots">
                        {slides.map((_, dotIdx) => (
                          <button
                            type="button"
                            class={`jp-dot ${dotIdx === idx ? 'active' : ''}`}
                            data-jp-go={dotIdx}
                            aria-label={`Slide ${dotIdx + 1}`}
                          ></button>
                        ))}
                      </div>
                      <button type="button" class="jp-arrow" data-jp-dir="next" aria-label="Slide tiếp">
                        <i class="fa-solid fa-arrow-right"></i>
                      </button>
                    </div>
                  </div>

                  <!-- Right Architectural Frame -->
                  <div class="jp-hero-right">
                    <div class="jp-frame-outer">
                      <div class="jp-frame-corner tl"></div>
                      <div class="jp-frame-corner br"></div>
                      <div class="jp-img-box">
                        <img src={slide.image} alt={slide.title} />
                      </div>
                      <div class="jp-frame-caption">
                        <div class="jfc-left">
                          <strong>Giải pháp tối ưu theo chuẩn mực quốc tế</strong>
                        </div>
                        <span class="jfc-badge"><i class="fa-solid fa-shield-halved"></i> Uy tín & Bảo mật</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- Architectural Ledger KPI Bar -->
          <div class="jp-kpi-ledger">
            {stats.map((st) => (
              <div class="jp-kpi-cell">
                <div class="jkc-number">
                  {st.number}<span class="jkc-suffix">{st.suffix}</span>
                </div>
                <strong class="jkc-label">{st.label}</strong>
                <span class="jkc-sub">{st.sub}</span>
              </div>
            ))}
          </div>

          <!-- Architectural Marquee Bar -->
          <div class="jp-marquee-bar">
            <div class="jpm-label">
              <i class="fa-solid fa-layer-group"></i>
              <span>NĂNG LỰC CỐT LÕI</span>
            </div>
            <div class="jpm-track-clip">
              <div class="jpm-track">
                <span>Phát triển phần mềm</span> <i class="fa-solid fa-diamond"></i>
                <span>Tư vấn giải pháp CNTT</span> <i class="fa-solid fa-diamond"></i>
                <span>Giải pháp thương mại điện tử</span> <i class="fa-solid fa-diamond"></i>
                <span>Xây dựng ứng dụng di động</span> <i class="fa-solid fa-diamond"></i>
                <span>Giải pháp đám mây</span> <i class="fa-solid fa-diamond"></i>
                <span>Xây dựng website chuẩn SEO</span> <i class="fa-solid fa-diamond"></i>
                <span>Xử lý dữ liệu & Chuyển đổi số</span> <i class="fa-solid fa-diamond"></i>
                <span>Hệ quản trị CMS & CRM</span> <i class="fa-solid fa-diamond"></i>
                <!-- Duplicate for seamless loop -->
                <span>Phát triển phần mềm</span> <i class="fa-solid fa-diamond"></i>
                <span>Tư vấn giải pháp CNTT</span> <i class="fa-solid fa-diamond"></i>
                <span>Giải pháp thương mại điện tử</span> <i class="fa-solid fa-diamond"></i>
                <span>Xây dựng ứng dụng di động</span> <i class="fa-solid fa-diamond"></i>
                <span>Giải pháp đám mây</span> <i class="fa-solid fa-diamond"></i>
                <span>Xây dựng website chuẩn SEO</span> <i class="fa-solid fa-diamond"></i>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. SERVICES SECTION (ARCHITECTURAL MATRIX) -->
      <section class="jp-services-sec" id="services">
        <div class="container">
          <div class="jp-sec-header">
            <span class="jp-eyebrow">{servicesSec.subTitle}</span>
            <h2 class="jp-sec-title">{servicesSec.title}</h2>
            <p class="jp-sec-desc">{servicesSec.desc}</p>
          </div>

          <div class="jp-services-ledger">
            {servicesSec.items.map((item) => (
              <div class="jp-service-cell">
                <div class="jsc-top">
                  <div class="jsc-icon">
                    <i class={item.icon}></i>
                  </div>
                </div>
                <h3 class="jsc-title">{item.title}</h3>
                <p class="jsc-desc">{item.desc}</p>
                <a href="/lien-he" class="jsc-more">
                  <span>Chi tiết dịch vụ</span>
                  <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 4. ABOUT ABSOLTECH (CORPORATE MONOGRAPH & MILESTONE TIMELINE) -->
      <section class="jp-about-sec" id="about">
        <div class="container">
          <div class="jp-sec-header">
            <span class="jp-eyebrow">{about.subLabel}</span>
            <h2 class="jp-sec-title">{about.heading}</h2>
            <p class="jp-sec-desc">Giá trị bền vững được khẳng định qua sự chuẩn mực trong quy trình kỹ thuật và niềm tin từ các tập đoàn quốc tế.</p>
          </div>

          <!-- Editorial Monograph Layout (Distinct from Mẫu 1 & Mẫu 2) -->
          <div class="jp-monograph-box">
            <!-- Top Row: Editorial Story + Framed Team Portrait -->
            <div class="jmb-top-grid">
              <div class="jmb-editorial">
                <div class="jmb-chapter">
                  <span class="chapter-divider"></span>
                  <span class="chapter-name">HỒ SƠ NĂNG LỰC DOANH NGHIỆP</span>
                </div>

                <p class="jmb-lead">{about.content}</p>

                <blockquote class="jmb-philosophy">
                  <div class="jmb-phi-label">TRIẾT LÝ VẬN HÀNH & SỨ MỆNH</div>
                  <p>“{about.quote}”</p>
                </blockquote>

                <div class="jmb-standards-row">
                  <div class="jmb-std-item">
                    <i class="fa-solid fa-check"></i>
                    <span>Quy trình kiểm thử chất lượng chuẩn Nhật Bản</span>
                  </div>
                  <div class="jmb-std-item">
                    <i class="fa-solid fa-check"></i>
                    <span>Bảo mật thông tin & An toàn dữ liệu tuyệt đối</span>
                  </div>
                  <div class="jmb-std-item">
                    <i class="fa-solid fa-check"></i>
                    <span>Đồng hành bảo trì, nâng cấp hệ thống dài hạn</span>
                  </div>
                </div>
              </div>

              <div class="jmb-portrait">
                <div class="jmb-photo-wrap">
                  <img src={about.teamImage} alt="Đội ngũ ABSoltech" loading="lazy" />
                  <div class="jmb-photo-stamp">
                    <strong>16+ NĂM</strong>
                    <span>PHÁT TRIỂN BỀN VỮNG</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Middle Row: 4-Step Corporate Milestone Timeline -->
            <div class="jmb-timeline-bar">
              {milestones.map((m) => (
                <div class="jmb-milestone">
                  <div class="jm-head">
                    <span class="jm-year">{m.year}</span>
                  </div>
                  <strong class="jm-title">{m.title}</strong>
                  <p class="jm-desc">{m.desc}</p>
                </div>
              ))}
            </div>

            <!-- Bottom Row: Japanese & International Partner Ledger Table -->
            <div class="jmb-partner-directory">
              <div class="jpd-header">
                <div class="jpd-title-group">
                  <h4>Đối Tác Chiến Lược Quốc Tế Tiêu Biểu</h4>
                </div>
                <span class="jpd-region-tag"><i class="fa-solid fa-earth-asia"></i> Nhật Bản • Hàn Quốc • Australia</span>
              </div>

              <div class="jpd-table">
                {partners.map((p) => (
                  <div class="jpd-cell">
                    <div class="jpd-cell-top">
                      <span class="jpd-region"><i class="fa-solid fa-location-dot"></i> {p.region}</span>
                    </div>
                    <div class="jpd-logo-frame">
                      <img src={p.logo} alt={p.name} loading="lazy" />
                    </div>
                    <div class="jpd-info">
                      <strong>{p.name}</strong>
                      <p>{p.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. PACKAGED SOFTWARE SUITE (STRUCTURED SPECIFICATION CATALOG) -->
      <section class="jp-products-sec" id="products">
        <div class="container">
          <div class="jp-sec-header">
            <span class="jp-eyebrow">{productsSec.subTitle}</span>
            <h2 class="jp-sec-title">{productsSec.title}</h2>
            <p class="jp-sec-desc">{productsSec.desc}</p>
          </div>

          <div class="jp-products-catalog">
            {productsSec.items.map((p) => (
              <div class="jp-catalog-card">
                <div class="jcc-header">
                  <span class="jcc-tagline">{p.tagline}</span>
                  <span class="jcc-badge">{p.badge}</span>
                </div>
                <div class="jcc-preview">
                  <img src={p.image} alt={p.name} loading="lazy" />
                </div>
                <div class="jcc-body">
                  <h3 class="jcc-name">{p.name}</h3>
                  <p class="jcc-desc">{p.desc}</p>
                  <div class="jcc-footer">
                    <a href="/lien-he" class="jcc-btn">
                      <span>Đăng ký trải nghiệm</span>
                      <i class="fa-solid fa-arrow-right"></i>
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 6. CLIENT TESTIMONIALS (EXECUTIVE CASE STUDY DOSSIER) -->
      <section class="jp-testimonials-sec" id="testimonials">
        <div class="container">
          <div class="jp-sec-header">
            <span class="jp-eyebrow">ĐỐI TÁC ĐÁNH GIÁ</span>
            <h2 class="jp-sec-title">Khách Hàng Nói Về Chúng Tôi</h2>
            <p class="jp-sec-desc">Hồ sơ ghi nhận phản hồi trực tiếp từ ban lãnh đạo các doanh nghiệp quốc tế đã hợp tác cùng ABSoltech.</p>
          </div>

          <!-- Executive Case Study Dossier Rows (Completely distinct from Mẫu 1 Grid & Mẫu 2 Tab Stage) -->
          <div class="jp-dossier-list">
            {reviews.map((r) => (
              <article class="jp-dossier-row">
                <!-- Left Column: Case Study Metadata -->
                <div class="jdr-meta-col">
                  <div class="jdr-code-row">
                    <span class="jdr-country"><i class="fa-solid fa-globe"></i> {r.country}</span>
                  </div>
                  <div class="jdr-client-box">
                    <div class="jdr-avatar">{r.avatar}</div>
                    <div>
                      <h4 class="jdr-author">{r.author}</h4>
                      <span class="jdr-role">{r.role}</span>
                      <strong class="jdr-company">{r.company}</strong>
                    </div>
                  </div>
                </div>

                <!-- Middle Column: Verbatim Executive Quote -->
                <div class="jdr-quote-col">
                  <div class="jdr-project-pill">
                    <i class="fa-solid fa-folder-tree"></i> Hạng mục: {r.projectType}
                  </div>
                  <p class="jdr-quote-text">“{r.quote}”</p>
                </div>

                <!-- Right Column: Quality Audit Stamp -->
                <div class="jdr-audit-col">
                  <div class="jdr-rating-box">
                    <span class="jdr-score">5.0</span>
                    <div class="jdr-stars">
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                      <i class="fa-solid fa-star"></i>
                    </div>
                    <span class="jdr-verified"><i class="fa-solid fa-shield-check"></i> ĐỐI TÁC XÁC THỰC</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 7. CALLOUT BANNER -->
      <section class="jp-callout-sec">
        <div class="container">
          <div class="jp-callout-banner">
            <div class="jcb-content">
              <span class="jcb-label">TƯ VẤN CHUYỂN ĐỔI SỐ DOANH NGHIỆP</span>
              <h2>{callout.title}</h2>
              <p>{callout.desc}</p>
            </div>
            <div class="jcb-actions">
              <a href={`tel:${callout.phone.replace(/\s+/g, '')}`} class="btn-jcb-phone">
                <div class="jcb-phone-icon"><i class="fa-solid fa-phone-volume"></i></div>
                <div class="jcb-phone-txt">
                  <span>Hotline tư vấn 24/7</span>
                  <strong>{callout.phone}</strong>
                </div>
              </a>
              <a href="/lien-he" class="btn-jcb-contact">
                <span>Đặt lịch tư vấn ngay</span>
                <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- 8. FOOTER -->
    <footer class="jp-footer">
      <div class="container">
        <div class="jp-footer-grid">
          <!-- Left Brand Blue Card (keeps dark SOLTECH logo text visible) -->
          <div class="jpf-brand-card">
            <img src="https://absoltech.vn/wp-content/uploads/2025/08/logo_dark_h400-768x132.png" alt="ABSoltech Logo" class="jpf-logo" />
            <h3 class="jpf-company">CÔNG TY CỔ PHẦN PHẦN MỀM AN BIÊN</h3>
            <p class="jpf-tax">MSDN: 0200838952 cấp ngày 07/11/2009 tại Sở KH&ĐT TP. Hải Phòng</p>

            <div class="jpf-offices">
              <div class="jpf-office-item">
                <i class="fa-solid fa-building"></i>
                <div><strong>Trụ sở Hải Phòng:</strong> Tầng 4, 22 Lý Tự Trọng, Hồng Bàng, Hải Phòng</div>
              </div>
              <div class="jpf-office-item">
                <i class="fa-solid fa-location-dot"></i>
