<script>
  let curJpSlide = 0;
  const jpSlides = document.querySelectorAll('.jp-slide');
  const totalJpSlides = jpSlides.length;

  function setJpSlide(index: number) {
    if (totalJpSlides === 0) return;
    curJpSlide = (index + totalJpSlides) % totalJpSlides;
    jpSlides.forEach((s, i) => {
      s.classList.toggle('active', i === curJpSlide);
    });
  }

  document.querySelectorAll('.jp-arrow').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dir = btn.getAttribute('data-jp-dir');
      setJpSlide(dir === 'next' ? curJpSlide + 1 : curJpSlide - 1);
    });
  });

  document.querySelectorAll('.jp-dot').forEach((dot) => {
    dot.addEventListener('click', () => {
      const idx = Number(dot.getAttribute('data-jp-go') || 0);
      setJpSlide(idx);
    });
  });

  setInterval(() => {
    setJpSlide(curJpSlide + 1);
  }, 6000);
</script>

