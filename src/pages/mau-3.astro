---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FloatingContact from '../components/FloatingContact.astro';

// Lấy dữ liệu thực từ Decap CMS
const homeEntry = await getEntry('homepage', 'index');
const homeData = homeEntry?.data;

const slides = homeData?.slides || [];
const about = homeData?.about || {
  heading: "Xây dựng Phần Mềm & Thiết Kế Website Chuyên Nghiệp",
  subLabel: "VỀ ABSOLTECH",
  content: "Thành lập tháng 12 năm 2007 - ABSoltech trải qua hơn 16 năm phát triển, chúng tôi đã trở thành thương hiệu doanh nghiệp CNTT hàng đầu tại khu vực Duyên Hải.",
  quote: "Sứ mệnh của chúng tôi là mang đến giá trị thặng dư lớn và sự thành công cho khách hàng",
  teamImage: "https://absoltech.vn/wp-content/uploads/2023/09/teamworks-absoltech-1024x683.jpg"
};
const servicesSec = homeData?.servicesSection || {
  subTitle: "CÁC DỊCH VỤ MÀ ABSOLTECH CUNG CẤP",
  title: "Dịch Vụ",
  desc: "Giải pháp công nghệ toàn diện nâng tầm doanh nghiệp trong kỷ nguyên số.",
  items: []
};
const productsSec = homeData?.productsSection || {
  subTitle: "SẢN PHẨM",
  title: "Phần Mềm Đóng Gói",
  desc: "Hệ sinh thái phần mềm đóng gói giải quyết triệt để bài toán vận hành của từng ngành nghề.",
  items: []
};
const callout = homeData?.callout || {
  title: "Bạn đang quan tâm tới chuyển đổi số?",
  desc: "Với kinh nghiệm hơn 20 năm triển khai ứng dụng CNTT trong nhiều lĩnh vực, các chuyên gia của chúng tôi sẽ đưa ra giải pháp tốt nhất cho doanh nghiệp của bạn",
  phone: "0985 18 5665"
};

const reviews = [
  {
    author: "Mr. David Henry",
    company: "DHM Digital",
    role: "CEO & Founder",
    quote: "Đội ngũ chuyên nghiệp dẫn đầu bởi Mr Công. Nhân ngày kỉ niệm 10 năm thành lập, các bạn đã luôn làm rất tốt. Hãy tiếp tục giữ vững tinh thần và hoàn thành tốt công việc nhé.",
    avatar: "DH"
  },
  {
    author: "Ms. Renae Christine",
    company: "OWHO",
    role: "Product Director",
    quote: "Những lập trình viên bậc A++, giao tiếp rất tốt. Họ vô cùng hữu ích và luôn túc trực sẵn sàng xử lý vấn đề, sự cố khẩn cấp cho bạn.",
    avatar: "RC"
  },
  {
    author: "Mr. Blake Bridge",
    company: "Room Connection",
    role: "Managing Partner",
    quote: "Tôi đã làm việc với ABSoft trong gần 2 năm để phát triển ứng dụng, trang web và nền tảng của mình. Họ là những người giỏi nhất trong công việc này. Giao tiếp hiệu quả, phản hồi nhanh chóng.",
    avatar: "BB"
  },
  {
    author: "Mr. Scott Price",
    company: "Marketing Solution",
    role: "Technical Lead",
    quote: "Chắc chắn là 1 công ty tuyệt vời rồi. Tôi đã hợp tác với Công và đội ngũ của anh ấy cho rất nhiều dự án và sẽ thêm nhiều dự án hơn nữa trong tương lai.",
    avatar: "SP"
  }
];

const partners = [
  { name: "SoftBank", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-softbank.png" },
  { name: "Bijin-Tokei", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-bijint.png" },
  { name: "World Air Plan", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-wap.png" },
  { name: "CyberAgent", logo: "https://absoltech.vn/wp-content/uploads/2022/03/absoltech-cyberagent.png" }
];

const stats = [
  { number: "05", suffix: "", label: "Quốc gia triển khai", icon: "fa-solid fa-earth-asia" },
  { number: "20", suffix: "+", label: "Đối tác chiến lược", icon: "fa-solid fa-handshake" },
  { number: "500", suffix: "+", label: "Dự án hoàn thành", icon: "fa-solid fa-laptop-code" },
  { number: "1000", suffix: "+", label: "Khách hàng tin dùng", icon: "fa-solid fa-users-gear" }
];
---

<Layout>
  <div class="aurora-creative-page">
    <!-- 1. CHUẨN HEADER 3 CẤP TỪ HEADER.ASTRO -->
    <Header />

    <main>
      <!-- 2. AURORA MESH & FLOATING ISLAND HERO + 3 INTERACTIVE PREVIEW CARDS -->
      <section class="ac-hero-sec">
        <div class="ac-blob blob-1"></div>
        <div class="ac-blob blob-2"></div>

        <div class="container relative">
          <!-- Main Hero Showcase Stage -->
          <div class="ac-hero-stage">
            {slides.map((s, idx) => (
              <div class={`ac-hero-main ${idx === 0 ? 'active' : ''}`} data-ac-panel={idx}>
                <div class="ach-left">
                  <div class="ach-badge">
                    <span class="pulse-ring"></span>
                    <span>ĐỐI TÁC CÔNG NGHỆ & CHUYỂN ĐỔI SỐ HÀNG ĐẦU</span>
                  </div>

                  <h1 class="ach-title">
                    <span class="ach-pre">{s.pretitle}</span>
                    <span class="ach-gradient-txt">{s.title}</span>
                  </h1>

                  <p class="ach-desc">{s.description}</p>

                  <div class="ach-cta-row">
                    <a href={s.btnPrimaryLink || '/lien-he'} class="btn-ac-primary">
                      <span>{s.btnPrimaryText || 'Bắt đầu dự án ngay'}</span>
                      <div class="bap-icon"><i class="fa-solid fa-arrow-right"></i></div>
                    </a>
                    <a href="tel:0985185665" class="btn-ac-call">
                      <div class="bac-icon"><i class="fa-solid fa-phone-volume"></i></div>
                      <div>
                        <small>Tư vấn trực tiếp 24/7</small>
                        <strong>0985 18 5665</strong>
                      </div>
                    </a>
                  </div>
                </div>

                <div class="ach-right">
                  <div class="ach-orbit-ring"></div>
                  <div class="ach-glass-card">
                    <img src={s.image} alt={s.title} class="ach-img" />
                  </div>
                  <!-- Floating Pills around Image -->
                  <div class="ach-float-pill pill-top">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>16+ Năm Kinh Nghiệm</span>
                  </div>
                  <div class="ach-float-pill pill-bottom">
                    <i class="fa-solid fa-globe"></i>
                    <span>Đối tác Nhật Bản • Hàn • Úc</span>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- 3 Interactive Thumbnail Dock Cards right below Hero (Bấm vào thẻ nào đổi luôn Hero) -->
          <div class="ac-hero-dock">
            {slides.map((s, idx) => (
              <button
                type="button"
                class={`ac-dock-card ${idx === 0 ? 'active' : ''}`}
                data-ac-trigger={idx}
              >
                <div class="adc-thumb">
                  <img src={s.image} alt={s.title} />
                </div>
                <div class="adc-info">
                  <span class="adc-step">GIẢI PHÁP 0{idx + 1}</span>
                  <strong>{s.title}</strong>
                  <p>{s.pretitle}</p>
                </div>
                <div class="adc-arrow">
                  <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </div>
              </button>
            ))}
          </div>
        </div>

        <!-- Soft Gradient Pill Marquee -->
        <div class="ac-pill-marquee">
          <div class="apm-track">
            <span class="apm-chip"><i class="fa-solid fa-code"></i> Phát triển phần mềm</span>
            <span class="apm-chip"><i class="fa-solid fa-lightbulb"></i> Tư vấn giải pháp CNTT</span>
            <span class="apm-chip"><i class="fa-solid fa-cart-shopping"></i> Giải pháp thương mại điện tử</span>
            <span class="apm-chip"><i class="fa-solid fa-mobile-screen"></i> Xây dựng ứng dụng di động</span>
            <span class="apm-chip"><i class="fa-solid fa-cloud"></i> Giải pháp đám mây</span>
            <span class="apm-chip"><i class="fa-solid fa-globe"></i> Xây dựng website chuẩn SEO</span>
            <span class="apm-chip"><i class="fa-solid fa-database"></i> Xử lý dữ liệu & Chuyển đổi số</span>
            <span class="apm-chip"><i class="fa-solid fa-users-rectangle"></i> Hệ quản trị CMS & CRM</span>
            <!-- Duplicate -->
            <span class="apm-chip"><i class="fa-solid fa-code"></i> Phát triển phần mềm</span>
            <span class="apm-chip"><i class="fa-solid fa-lightbulb"></i> Tư vấn giải pháp CNTT</span>
            <span class="apm-chip"><i class="fa-solid fa-cart-shopping"></i> Giải pháp thương mại điện tử</span>
            <span class="apm-chip"><i class="fa-solid fa-mobile-screen"></i> Xây dựng ứng dụng di động</span>
            <span class="apm-chip"><i class="fa-solid fa-cloud"></i> Giải pháp đám mây</span>
            <span class="apm-chip"><i class="fa-solid fa-globe"></i> Xây dựng website chuẩn SEO</span>
          </div>
        </div>
      </section>

      <!-- 3. DỊCH VỤ: INTERACTIVE ACCORDION SHOWCASE (CỘT TRÁI MỞ RỘNG + CỘT PHẢI SÂN KHẤU LỚN) -->
      <section class="ac-services-sec" id="services">
        <div class="container">
          <div class="ac-sec-head">
            <span class="ac-pill-tag"><i class="fa-solid fa-wand-magic-sparkles"></i> {servicesSec.subTitle}</span>
            <h2>Hệ Sinh Thái {servicesSec.title} Chuyên Nghiệp</h2>
            <p>{servicesSec.desc}</p>
          </div>

          <div class="ac-service-studio">
            <!-- Left Interactive Accordion List -->
            <div class="ass-accordion">
              {servicesSec.items.map((item, idx) => (
                <div
                  class={`ass-acc-item ${idx === 0 ? 'active' : ''}`}
                  data-srv-trigger={idx}
                >
                  <div class="aai-header">
                    <div class="aai-icon">
                      <i class={item.icon}></i>
                    </div>
                    <div class="aai-title-wrap">
                      <span class="aai-tag">{item.tag}</span>
                      <h3>{item.title}</h3>
                    </div>
                    <div class="aai-toggle">
                      <i class="fa-solid fa-chevron-right"></i>
                    </div>
                  </div>
                  <div class="aai-body">
                    <p>{item.desc}</p>
                  </div>
                </div>
              ))}
            </div>

            <!-- Right Dynamic Spotlight Card -->
            <div class="ass-spotlight">
              {servicesSec.items.map((item, idx) => (
                <div class={`ass-spot-card ${idx === 0 ? 'active' : ''}`} data-srv-panel={idx}>
                  <div class="asc-top-visual">
                    <div class="asc-big-icon">
                      <i class={item.icon}></i>
                    </div>
                    <span class="asc-num">0{idx + 1}</span>
                  </div>

                  <div class="asc-content">
                    <span class="asc-badge">{item.tag}</span>
                    <h3>{item.title}</h3>
                    <p>{item.desc}</p>

                    <div class="asc-benefits">
                      <div class="ascb-item">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Thiết kế may đo riêng theo quy trình vận hành</span>
                      </div>
                      <div class="ascb-item">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Tối ưu tốc độ, bảo mật cao & dễ dàng mở rộng</span>
                      </div>
                      <div class="ascb-item">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Bàn giao mã nguồn chuẩn & hỗ trợ kỹ thuật 24/7</span>
                      </div>
                    </div>

                    <div class="asc-actions">
                      <a href="/lien-he" class="btn-ac-white">
                        <span>Nhận tư vấn & Báo giá</span>
                        <i class="fa-solid fa-arrow-right"></i>
                      </a>
                      <a href="/du-an" class="btn-ac-ghost-light">
                        <span>Xem dự án thực tế</span>
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 4. VỀ ABSOLTECH: BỐ CỤC TÂM ĐIỂM ĐỐI XỨNG 3 CỘT + DẢI ĐỐI TÁC QUỐC TẾ TO RÕ -->
      <section class="ac-about-sec" id="about">
        <div class="container">
          <div class="ac-sec-head">
            <span class="ac-pill-tag"><i class="fa-solid fa-award"></i> {about.subLabel}</span>
            <h2>{about.heading}</h2>
            <p>Đồng hành cùng sự thịnh vượng của hơn 1000+ doanh nghiệp trong nước và quốc tế từ năm 2007.</p>
          </div>

          <!-- 3-Column Centerpiece Hub (Trái: Câu chuyện | Giữa: Ảnh Đội Ngũ | Phải: 4 Thẻ Chỉ Số) -->
          <div class="ac-about-centerpiece">
            <!-- Left Story Card -->
            <div class="aac-story-card">
              <div class="aac-badge-top">
                <i class="fa-solid fa-rocket"></i> HÀNH TRÌNH 16+ NĂM PHÁT TRIỂN
              </div>
              <p class="aac-text">{about.content}</p>
              <div class="aac-quote-box">
                <i class="fa-solid fa-quote-left"></i>
                <p>“{about.quote}”</p>
              </div>
              <a href="/lien-he" class="aac-more-btn">
                <span>Kết nối cùng đội ngũ chuyên gia</span>
                <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>

            <!-- Center Framed Team Photo -->
            <div class="aac-photo-center">
              <img src={about.teamImage} alt="Đội ngũ ABSoltech" loading="lazy" />
              <div class="aac-photo-float">
                <div class="apf-icon"><i class="fa-solid fa-shield-halved"></i></div>
                <div>
                  <strong>Thương hiệu CNTT Hàng Đầu</strong>
                  <span>Khu vực Duyên Hải Bắc Bộ & Toàn Quốc</span>
                </div>
              </div>
            </div>

            <!-- Right 2x2 Stats Cards -->
            <div class="aac-stats-grid">
              {stats.map((st) => (
                <div class="aac-stat-box">
                  <div class="asb-icon"><i class={st.icon}></i></div>
                  <div class="asb-num">{st.number}<span>{st.suffix}</span></div>
                  <strong>{st.label}</strong>
                </div>
              ))}
            </div>
          </div>

          <!-- Clean Prominent Partner Showcase Bar (Logo to rõ, không rối chữ) -->
          <div class="ac-partner-showcase">
            <div class="aps-title">
              <span><i class="fa-solid fa-earth-asia"></i> ĐỐI TÁC QUỐC TẾ TIÊU BIỂU</span>
              <small>Nhật Bản • Hàn Quốc • Australia</small>
            </div>
            <div class="aps-logos">
              {partners.map((p) => (
                <div class="aps-logo-box" title={p.name}>
                  <img src={p.logo} alt={p.name} loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 5. SẢN PHẨM ĐÓNG GÓI: HORIZONTAL SPLIT CARDS (2 CỘT × 3 HÀNG — ẢNH TRÁI, NỘI DUNG PHẢI) -->
      <section class="ac-products-sec" id="products">
        <div class="container">
          <div class="ac-sec-head">
            <span class="ac-pill-tag"><i class="fa-solid fa-cubes"></i> {productsSec.subTitle}</span>
            <h2>{productsSec.title} Chuyên Biệt</h2>
            <p>{productsSec.desc}</p>
          </div>

          <!-- 2-Column Horizontal Split Cards (Khác hẳn lưới 3 cột của Mẫu 1 và Tab của Mẫu 2) -->
          <div class="ac-products-duo-grid">
            {productsSec.items.map((p) => (
              <div class="ac-product-duo-card">
                <div class="apdc-media">
                  <span class="apdc-badge">{p.badge}</span>
                  <img src={p.image} alt={p.name} loading="lazy" />
                </div>
                <div class="apdc-info">
                  <span class="apdc-tagline">{p.tagline}</span>
                  <h3>{p.name}</h3>
                  <p>{p.desc}</p>
                  <div class="apdc-footer">
                    <a href="/lien-he" class="apdc-btn">
                      <span>Đăng ký dùng thử</span>
                      <i class="fa-solid fa-arrow-right"></i>
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 6. KHÁCH HÀNG NÓI VỀ CHÚNG TÔI: INTERACTIVE STORY SLIDER + METRICS BAR -->
      <section class="ac-testimonials-sec" id="testimonials">
        <div class="container">
          <div class="ac-sec-head">
            <span class="ac-pill-tag"><i class="fa-solid fa-heart"></i> NIỀM TIN KHÁCH HÀNG TOÀN CẦU</span>
            <h2>Đối Tác Nói Gì Về ABSoltech?</h2>
            <p>Hơn 98% khách hàng quốc tế và doanh nghiệp trong nước tiếp tục đồng hành dài hạn sau dự án đầu tiên.</p>
          </div>

          <!-- Top Client Avatar Pills Switcher (Khác hẳn lưới 4 thẻ của Mẫu 1 và cột trái của Mẫu 2) -->
          <div class="act-avatar-dock">
            {reviews.map((r, idx) => (
              <button
                type="button"
                class={`act-person-pill ${idx === 0 ? 'active' : ''}`}
                data-testi-trigger={idx}
              >
                <span class="app-ava">{r.avatar}</span>
                <div class="app-meta">
                  <strong>{r.author}</strong>
                  <small>{r.company}</small>
                </div>
              </button>
            ))}
          </div>

          <!-- Center Stage Quote Card -->
          <div class="act-stage-wrap">
            {reviews.map((r, idx) => (
              <div class={`act-featured-stage ${idx === 0 ? 'active' : ''}`} data-testi-panel={idx}>
                <div class="afs-left-profile">
                  <div class="afs-big-ava">{r.avatar}</div>
                  <h3>{r.author}</h3>
                  <span class="afs-role">{r.role}</span>
                  <span class="afs-comp"><i class="fa-solid fa-building"></i> {r.company}</span>
                  <div class="afs-stars">
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <span>5.0</span>
                  </div>
                </div>
                <div class="afs-right-quote">
                  <i class="fa-solid fa-quote-left afs-qmark"></i>
                  <blockquote>“{r.quote}”</blockquote>
                  <div class="afs-verified-bar">
                    <span><i class="fa-solid fa-circle-check"></i> Đánh giá xác thực từ đối tác quốc tế</span>
                    <span>Dự án triển khai dài hạn</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 7. CHUYỂN ĐỔI SỐ & GỬI YÊU CẦU TƯ VẤN: STUDIO WORKSPACE (TRÁI: LỘ TRÌNH 3 BƯỚC + HOTLINE | PHẢI: FORM TƯ VẤN NỔI) -->
      <section class="ac-dx-studio-sec" id="contact-studio">
        <div class="ac-dx-bg-orb orb-a"></div>
        <div class="ac-dx-bg-orb orb-b"></div>

        <div class="container relative">
          <div class="ac-dx-grid">
            <!-- Left: Digital Transformation Roadmap & Direct Expert Connect -->
            <div class="ac-dx-left">
              <span class="ac-dx-badge"><i class="fa-solid fa-wand-magic-sparkles"></i> ĐỒNG HÀNH CHUYỂN ĐỔI SỐ TOÀN DIỆN</span>
              <h2>{callout.title}</h2>
              <p class="ac-dx-lead">{callout.desc}</p>

              <!-- 3-Step Digital Transformation Roadmap -->
              <div class="ac-dx-steps">
                <div class="adxs-item">
                  <div class="adxs-num">01</div>
                  <div class="adxs-txt">
                    <strong>Khảo sát & Tư vấn Kiến trúc Số 1:1</strong>
                    <span>Đánh giá quy trình vận hành thực tế và đề xuất giải pháp công nghệ tối ưu chi phí.</span>
                  </div>
                </div>
                <div class="adxs-item">
                  <div class="adxs-num">02</div>
                  <div class="adxs-txt">
                    <strong>Thiết kế May đo & Triển khai Chuẩn Agile</strong>
                    <span>Phát triển hệ thống phần mềm, ERP/CRM, Web/App theo đúng đặc thù doanh nghiệp.</span>
                  </div>
                </div>
                <div class="adxs-item">
                  <div class="adxs-num">03</div>
                  <div class="adxs-txt">
                    <strong>Chuyển giao Làm chủ & Đồng hành 24/7</strong>
                    <span>Đào tạo đội ngũ vận hành, bảo hành trọn đời và nâng cấp mở rộng linh hoạt.</span>
                  </div>
                </div>
              </div>

              <!-- Direct Expert Hotline Bar -->
              <div class="ac-dx-hotline-card">
                <div class="adxh-left">
                  <div class="adxh-ic"><i class="fa-solid fa-headset"></i></div>
                  <div>
                    <small>Tư vấn trực tiếp cùng Chuyên gia Trưởng</small>
                    <strong>Hotline 24/7: {callout.phone}</strong>
                  </div>
                </div>
