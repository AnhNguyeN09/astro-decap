---
interface Props {
  data?: {
    heading: string;
    subLabel: string;
    content: string;
    quote: string;
    teamImage: string;
  };
}

const { data } = Astro.props;

const defaultData = {
  heading: "Xây dựng Phần Mềm & Thiết Kế Website Chuyên Nghiệp",
  subLabel: "VỀ ABSOLTECH",
  content: "Thành lập tháng 12 năm 2007 - ABSoltech (đổi tên từ ABSoft ngày 02/02/2022) - trải qua 16 năm phát triển, chúng tôi đã trở thành một thương hiệu doanh nghiệp CNTT hàng đầu tại khu vực Duyên Hải. Đặc biệt, ABSoltech đã có kinh nghiệm hợp tác sản xuất các phần mềm cho những doanh nghiệp hàng đầu của Nhật Bản, Hàn Quốc, Australia. những kinh nghiệm đó là giá trị, là tài sản của công ty chúng tôi. Chúng tôi luôn có chủ trương đào tạo ý thức, kỹ thuật cho nhân viên thông qua các tiêu chuẩn quốc tế, để đáp ứng nhu cầu khách hàng.",
  quote: "Sứ mệnh của chúng tôi là mang đến giá trị thặng dư lớn và sự thành công cho khách hàng",
  teamImage: "https://absoltech.vn/wp-content/uploads/2023/09/teamworks-absoltech-1024x683.jpg"
};

const about = data || defaultData;
---
<section class="about-section" id="about">
  <div class="about-bg-overlay"></div>
  <div class="container relative">
    <div class="about-grid">
      <!-- Cột Nội Dung Bên Trái -->
      <div class="about-content">
        <h1 class="about-main-heading">{about.heading}</h1>
        <h4 class="about-sub-label">{about.subLabel}</h4>

        <div class="about-text-body">
          <p>{about.content}</p>
        </div>

        <blockquote class="about-quote">
          <p>{about.quote}</p>
        </blockquote>

        <div class="partners-block">
          <h3 class="partners-heading">Đối tác hàng đầu chúng tôi đã làm việc</h3>
          <div class="partners-grid">
            <div class="partner-box" title="SoftBank">
              <img src="https://absoltech.vn/wp-content/uploads/2022/03/absoltech-softbank.png" alt="absoltech softbank" />
            </div>
            <div class="partner-box" title="Bijint">
              <img src="https://absoltech.vn/wp-content/uploads/2022/03/absoltech-bijint.png" alt="absoltech bijint" />
            </div>
            <div class="partner-box" title="WAP">
              <img src="https://absoltech.vn/wp-content/uploads/2022/03/absoltech-wap.png" alt="absoltech wap" />
            </div>
            <div class="partner-box" title="CyberAgent">
              <img src="https://absoltech.vn/wp-content/uploads/2022/03/absoltech-cyberagent.png" alt="absoltech cyberagent" />
            </div>
          </div>
        </div>
      </div>

      <!-- Cột Hình Ảnh Đội Ngũ Bên Phải -->
      <div class="about-visual">
        <div class="team-img-card">
          <img src={about.teamImage} alt="Đội ngũ nhân sự ABSoltech" />
          <div class="team-experience-badge">
            <span class="exp-years">16+</span>
            <span class="exp-text">Năm kinh nghiệm công nghệ</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    padding: 100px 0;
    background: #ffffff url('https://absoltech.vn/wp-content/uploads/2022/03/aht-30.png.webp') no-repeat right bottom;
    background-size: 500px auto;
    overflow: hidden;
  }

  .about-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 40%, rgba(240, 249, 255, 0.9) 100%);
    z-index: 1;
  }

  .relative {
    position: relative;
    z-index: 2;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 60px;
    align-items: center;
  }

  .about-main-heading {
    font-size: 34px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.3;
    margin-bottom: 8px;
    letter-spacing: -0.5px;
  }

  .about-sub-label {
    font-size: 15px;
    font-weight: 700;
    color: #0095da;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 24px;
  }

  .about-text-body p {
    font-size: 15.5px;
    line-height: 1.8;
    color: #475569;
    margin-bottom: 24px;
    text-align: justify;
  }

  .about-quote {
    border-left: 4px solid #0095da;
    padding: 14px 20px;
    background: #f0f9ff;
    border-radius: 0 8px 8px 0;
    margin-bottom: 30px;
  }

  .about-quote p {
    font-size: 16px;
    font-style: italic;
    font-weight: 600;
    color: #0369a1;
    line-height: 1.6;
    margin: 0;
  }

  .partners-block {
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid #e2e8f0;
  }

  .partners-heading {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    color: #64748b;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .partner-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: all 0.25s ease;
  }

  .partner-box:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 16px rgba(0, 149, 218, 0.15);
    border-color: #0095da;
  }

  .partner-box img {
    max-height: 38px;
    max-width: 100%;
    object-fit: contain;
  }

  .team-img-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.15);
    border: 6px solid #ffffff;
  }

  .team-img-card img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s ease;
  }

  .team-img-card:hover img {
    transform: scale(1.03);
  }

  .team-experience-badge {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background: linear-gradient(135deg, #0095da 0%, #0077b6 100%);
    color: #ffffff;
    padding: 14px 22px;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(0, 149, 218, 0.4);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .exp-years {
    font-size: 28px;
    font-weight: 800;
    line-height: 1;
  }

  .exp-text {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    margin-top: 4px;
    letter-spacing: 0.5px;
  }

  @media (max-width: 992px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .partners-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .about-main-heading {
      font-size: 26px;
    }
  }
</style>
