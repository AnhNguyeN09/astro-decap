---
const stats = [
  { number: "5", suffix: "", label: "Quốc Gia", icon: "fa-solid fa-earth-americas", desc: "Triển khai dự án quốc tế" },
  { number: "20", suffix: "+", label: "Đối Tác Lớn", icon: "fa-solid fa-handshake", desc: "Hợp tác chiến lược bền vững" },
  { number: "500", suffix: "+", label: "Dự Án Thành Công", icon: "fa-solid fa-diagram-project", desc: "Phần mềm & Website vận hành" },
  { number: "1000", suffix: "+", label: "Khách Hàng", icon: "fa-solid fa-users", desc: "Doanh nghiệp trong & ngoài nước" },
];
---
<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      {stats.map((s) => (
        <div class="stat-card">
          <div class="stat-icon-circle">
            <i class={s.icon}></i>
          </div>
          <div class="stat-number">
            <span>{s.number}</span>
            <span class="stat-suffix">{s.suffix}</span>
          </div>
          <h4 class="stat-label">{s.label}</h4>
          <p class="stat-desc">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats-section {
    padding: 80px 0;
    background: linear-gradient(135deg, #0b1325 0%, #172554 100%);
    color: #ffffff;
    position: relative;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }

  .stat-card {
    text-align: center;
    padding: 30px 20px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    transition: all 0.3s ease;
  }

  .stat-card:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-5px);
    border-color: rgba(0, 149, 218, 0.5);
  }

  .stat-icon-circle {
    width: 60px;
    height: 60px;
    margin: 0 auto 16px auto;
    background: rgba(0, 149, 218, 0.15);
    border: 1px solid rgba(0, 149, 218, 0.4);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: #38bdf8;
  }

  .stat-number {
    font-size: 44px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 6px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .stat-suffix {
    color: var(--primary);
  }

  .stat-label {
    font-size: 18px;
    font-weight: 700;
    color: #e2e8f0;
    margin-bottom: 6px;
  }

  .stat-desc {
    font-size: 13px;
    color: #94a3b8;
  }

  @media (max-width: 992px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
