<style>
  .top-bar {
    background-color: #0b1325;
    color: #94a3b8;
    font-size: 13px;
    padding: 7px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .top-bar-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top-info {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .top-info-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #cbd5e1;
    font-weight: 500;
  }

  .top-info-item i {
    color: var(--primary);
  }

  .top-info-item:hover {
    color: #ffffff;
  }

  .sep {
    color: rgba(255, 255, 255, 0.2);
  }

  .top-meta {
    font-size: 12px;
    color: #64748b;
  }

  /* Header styles */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 82px;
    position: relative;
  }

  .brand-logo img {
    height: 48px;
    width: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 24px;
  }

  .nav-link {
    font-size: 14px;
    font-weight: 700;
    color: #1e293b;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 28px 0;
    position: relative;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  .nav-link i {
    font-size: 11px;
    color: #64748b;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .nav-link:hover,
  .nav-item:hover > .nav-link {
    color: var(--primary);
  }

  .nav-item:hover > .nav-link i {
    color: var(--primary);
    transform: rotate(180deg);
  }

  /* MENU CẤP 2 (DROPDOWN CHÍNH) */
  .has-dropdown {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 250px;
    background: #ffffff;
    border-radius: var(--radius-sm);
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.12);
    padding: 10px 0;
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.25s ease;
    border: 1px solid var(--gray-200);
    z-index: 1010;
  }

  .has-dropdown:hover > .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-menu > li {
    position: relative;
  }

  .dropdown-menu > li > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 20px;
    font-size: 14.5px;
    color: #1e293b;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .dropdown-menu > li > a i {
    font-size: 11px;
    color: #94a3b8;
    transition: transform 0.2s ease;
  }

  .dropdown-menu > li:hover > a {
    background-color: #f0f9ff;
    color: var(--primary);
  }

  .dropdown-menu > li:hover > a i {
    color: var(--primary);
    transform: translateX(3px);
  }

  /* MENU CẤP 3 */
  .has-submenu {
    position: relative;
  }

  .submenu-level3 {
    position: absolute;
    top: -10px;
    left: 100%;
    width: 320px;
    background: #ffffff;
    border-radius: var(--radius-sm);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.14);
    padding: 10px 0;
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateX(12px);
    transition: all 0.2s ease;
    border: 1px solid var(--gray-200);
    z-index: 1020;
  }

  .has-submenu:hover > .submenu-level3 {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  .submenu-level3 li a {
    display: block;
    padding: 8px 22px;
    font-size: 14px;
    color: #475569;
    font-weight: 500;
    line-height: 1.4;
    transition: all 0.18s ease;
  }

  .submenu-level3 li a:hover {
    background-color: #f8fafc;
    color: var(--primary);
    padding-left: 28px;
    font-weight: 600;
  }

  /* Actions & Mobile */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .btn-header {
    padding: 10px 20px;
    font-size: 14px;
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 22px;
    color: #1e293b;
    cursor: pointer;
  }

  @media (max-width: 992px) {
    .top-meta {
      display: none;
    }

    .main-nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: #ffffff;
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
      display: none;
      padding: 20px;
      max-height: 80vh;
      overflow-y: auto;
    }

    .main-nav.open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .nav-link {
      padding: 8px 0;
    }

    .dropdown-menu,
    .submenu-level3 {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: none;
      padding-left: 15px;
      width: 100%;
      display: none;
    }

    .has-dropdown:hover > .dropdown-menu,
    .has-submenu:hover > .submenu-level3 {
      display: block;
    }

    .mobile-toggle {
      display: block;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobileToggle');
  const nav = document.getElementById('mainNav');
  if (toggleBtn && nav) {
    toggleBtn.addEventListener('click', () => {
      nav.classList.toggle('open');
    });
  }
</script>
