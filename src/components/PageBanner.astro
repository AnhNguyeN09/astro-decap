---
interface Props {
  badge?: string;
  badgeIcon?: string;
  title: string;
  description?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const {
  badge,
  badgeIcon = 'fa-solid fa-layer-group',
  title,
  description,
  breadcrumbs = []
} = Astro.props;
---

<section class="page-hero-banner">
  <div class="container">
    <div class="hero-content">
      {badge && (
        <span class="hero-badge">
          {badgeIcon && <i class={badgeIcon}></i>}
          <span>{badge}</span>
        </span>
      )}
      <h1 class="hero-title">{title}</h1>
      {description && <p class="hero-desc">{description}</p>}
      
      {breadcrumbs.length > 0 && (
        <nav class="hero-breadcrumbs" aria-label="Breadcrumb">
          <a href="/"><i class="fa-solid fa-house"></i> Trang chủ</a>
          {breadcrumbs.map((crumb, idx) => (
            <>
              <i class="fa-solid fa-chevron-right crumb-sep"></i>
              {crumb.href ? (
                <a href={crumb.href}>{crumb.label}</a>
              ) : (
                <span class="crumb-current">{crumb.label}</span>
              )}
            </>
          ))}
        </nav>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero-banner {
    background: linear-gradient(135deg, #0b192c 0%, #1a365d 60%, #0095da 100%);
    color: #ffffff;
    padding: 58px 0 52px 0;
    position: relative;
    overflow: hidden;
  }

  .page-hero-banner::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -15%;
    width: 650px;
    height: 650px;
    background: radial-gradient(circle, rgba(0, 149, 218, 0.28) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .page-hero-banner::after {
    content: '';
    position: absolute;
    bottom: -40%;
    left: 20%;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.05) 0%, transparent 65%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-content {
    max-width: 820px;
    position: relative;
    z-index: 2;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 6px 14px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    color: #e0f2fe;
    margin-bottom: 16px;
    backdrop-filter: blur(8px);
  }

  .hero-title {
    font-size: 38px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.25;
    margin-bottom: 14px;
    letter-spacing: -0.5px;
  }

  .hero-desc {
    font-size: 16px;
    color: #cbd5e1;
    line-height: 1.6;
    margin: 0;
  }

  .hero-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    font-size: 13px;
    color: #94a3b8;
  }

  .hero-breadcrumbs a {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .hero-breadcrumbs a:hover {
    color: #38bdf8;
  }

  .crumb-sep {
    font-size: 10px;
    color: #64748b;
  }

  .crumb-current {
    color: #38bdf8;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .page-hero-banner {
      padding: 44px 0 38px 0;
    }

    .hero-title {
      font-size: 28px;
    }

    .hero-desc {
      font-size: 14.5px;
    }
  }
</style>
