<!-- Main Footer -->
<footer class="site-footer" id="contact">
  <div class="footer-inner-wrap">
    <div class="footer-columns-row">
      <!-- CỘT TRÁI (MÀU XANH NỀN #0095da) -->
      <div class="col-left-blue">
        <div class="blue-inner">
          <div class="footer-logo-wrap">
            <img src="https://absoltech.vn/wp-content/uploads/2025/08/logo_dark_h400-768x132.png" alt="ABSoltech Logo Footer" />
          </div>

          <div class="company-legal-info">
            <p class="company-name"><strong>CÔNG TY CP PHẦN MỀM AN BIÊN</strong></p>
            <p class="company-details">
              <strong>VPGD</strong>: Tầng 4, 22 Lý Tự Trọng, Hồng Bàng, Hải Phòng, Việt Nam<br />
              <strong>MSDN</strong>: 0200838952 cấp 07/11/2009<br />
              <strong>Cơ quan cấp</strong>: Phòng DKKD - Sở Kế hoạch và đầu tư Hải Phòng
            </p>
          </div>

          <div class="company-email-link">
            <a href="mailto:contact@absoltech.vn">
              <i class="fa-regular fa-envelope"></i>
              <span>contact@absoltech.vn</span>
            </a>
          </div>

          <div class="f-divider"></div>

          <!-- Khối Điện thoại có ẢNH ART_PHONE.WEBP -->
          <div class="phone-block-with-art">
            <div class="art-phone-img">
              <img src="https://absoltech.vn/wp-content/uploads/2025/07/art_phone.webp" alt="art phone" />
            </div>
            <div class="phone-numbers">
              <a href="tel:+84985185665" class="phone-link">
                <i class="fa-solid fa-phone"></i>
                <span>(+84) 985 185 665</span>
              </a>
              <a href="tel:+842257106222" class="phone-link">
                <i class="fa-solid fa-phone"></i>
                <span>(+84) 225 710 6222</span>
              </a>
            </div>
          </div>

          <div class="f-divider"></div>

          <!-- Khối Địa chỉ có ẢNH ART_MAIL.WEBP -->
          <div class="branches-block-with-art">
            <div class="branches-text">
              <p><strong>HÀ NỘI</strong><br />Số 4, LK4 - TT1, số 96-96B Nguyễn Huy Tưởng, P. Thanh Xuân Trung, Q. Thanh Xuân, T.P Hà Nội</p>
              <p><strong>TP HỒ CHÍ MINH</strong><br />383 Nguyễn Duy Trinh, Bình Trưng Tây, Tp Thủ Đức, HCM</p>
              <p><strong>THANH HÓA</strong><br />11 Cửa Hữu, Phường Tân Sơn, Tp.Thanh Hoá</p>
            </div>
            <div class="art-mail-img">
              <img src="https://absoltech.vn/wp-content/uploads/2025/07/art_mail.webp" alt="art mail" />
            </div>
          </div>
        </div>
      </div>

      <!-- CỘT PHẢI (FORM KẾT NỐI VỚI CHÚNG TÔI - THIẾT KẾ CẢI TIẾN SANG TRỌNG) -->
      <div class="col-right-form">
        <div class="form-card-container">
          <div class="form-header-badge">
            <span class="sub-badge"><i class="fa-solid fa-comments"></i> HỖ TRỢ 24/7</span>
            <h2 class="connect-title">Kết nối với chúng tôi</h2>
            <p class="connect-subtitle">Gửi yêu cầu hợp tác hoặc yêu cầu báo giá giải pháp, đội ngũ chuyên gia của ABSoltech sẽ liên hệ tư vấn trong vòng 24 giờ.</p>
          </div>

          <form class="absoltech-connect-form" onsubmit="event.preventDefault(); alert('Cảm ơn bạn đã liên hệ ABSoltech! Chúng tôi sẽ phản hồi sớm nhất.');">
            <div class="form-grid-fields">
              <!-- Họ và Tên -->
              <div class="field-item">
                <label class="field-label">Họ và Tên <span class="required">*</span></label>
                <div class="input-with-icon">
                  <i class="fa-regular fa-user"></i>
                  <input type="text" placeholder="Nguyễn Văn A" required class="modern-input" />
                </div>
              </div>

              <!-- Số điện thoại -->
              <div class="field-item">
                <label class="field-label">Số điện thoại <span class="required">*</span></label>
                <div class="input-with-icon">
                  <i class="fa-solid fa-phone"></i>
                  <input type="tel" placeholder="0985 xxx xxx" required class="modern-input" />
                </div>
              </div>

              <!-- Email -->
              <div class="field-item">
                <label class="field-label">Email liên hệ <span class="required">*</span></label>
                <div class="input-with-icon">
                  <i class="fa-regular fa-envelope"></i>
                  <input type="email" placeholder="example@company.com" required class="modern-input" />
                </div>
              </div>

              <!-- Tên công ty -->
              <div class="field-item">
                <label class="field-label">Tên công ty / Doanh nghiệp</label>
                <div class="input-with-icon">
                  <i class="fa-regular fa-building"></i>
                  <input type="text" placeholder="Công ty ABC" class="modern-input" />
                </div>
              </div>
            </div>

            <!-- Lời nhắn -->
            <div class="field-item textarea-item">
              <label class="field-label">Nhu cầu triển khai / Lời nhắn <span class="required">*</span></label>
              <div class="input-with-icon icon-top">
                <i class="fa-regular fa-comment-dots"></i>
                <textarea rows="4" placeholder="Mô tả tóm tắt nhu cầu phát triển phần mềm, thiết kế web, mobile app..." required class="modern-textarea"></textarea>
              </div>
            </div>

            <!-- Nút Submit -->
            <div class="form-submit-row">
              <button type="submit" class="btn-submit-premium">
                <span>Gửi thông tin liên hệ</span>
                <i class="fa-solid fa-paper-plane"></i>
              </button>
              <div class="form-guarantee">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Thông tin được bảo mật 100% theo tiêu chuẩn quốc tế</span>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar: Bản quyền & Mạng xã hội & Điều khoản -->
  <div class="bottom-bar">
    <div class="container bottom-bar-container">
      <div class="copy-left">
        <p>Copyright © 2026 ABSoltech JSC</p>
      </div>

      <div class="social-center">
        <a href="https://facebook.com/ABSoltechJSC" target="_blank" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
        <a href="https://facebook.com/ABSoltechJSC" target="_blank" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
        <a href="https://facebook.com/ABSoltechJSC" target="_blank" aria-label="Twitter"><i class="fa-brands fa-twitter"></i></a>
        <a href="https://facebook.com/ABSoltechJSC" target="_blank" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
        <a href="https://youtube.com/@absoltech4847" target="_blank" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
      </div>

      <div class="links-right">
        <a href="#">Điều khoản</a>
        <a href="#">Chính sách</a>
        <a href="#">Cookies</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* MAIN FOOTER ROW */
  .site-footer {
    background-color: #ffffff;
  }

  .footer-columns-row {
    display: grid;
    grid-template-columns: 40% 60%;
    width: 100%;
  }

  /* CỘT TRÁI NỀN XANH DƯƠNG */
  .col-left-blue {
    background: linear-gradient(180deg, #0095da 0%, #0284c7 100%);
    color: #ffffff;
    padding: 50px 45px;
  }

  .footer-logo-wrap {
    margin-bottom: 24px;
  }

  .footer-logo-wrap img {
    max-width: 300px;
    height: auto;
  }

  .company-name {
    font-size: 17px;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
  }

  .company-details {
    font-size: 14px;
    line-height: 1.9;
    color: #e0f2fe;
    margin-bottom: 16px;
  }

  .company-email-link a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-size: 14.5px;
    font-weight: 600;
  }

  .company-email-link a:hover {
    text-decoration: underline;
  }

  .f-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.25);
    margin: 22px 0;
  }

  .phone-block-with-art {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 20px;
    align-items: center;
  }

  .art-phone-img img {
    max-width: 85px;
    height: auto;
    filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.2));
  }

  .phone-numbers {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .phone-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
  }

  .phone-link:hover {
    text-decoration: underline;
  }

  .branches-block-with-art {
    display: grid;
    grid-template-columns: 1fr 100px;
    gap: 20px;
    align-items: center;
    margin-top: 10px;
  }

  .branches-text {
    font-size: 13.5px;
    line-height: 1.8;
    color: #f0fdf4;
  }

  .branches-text p {
    margin-bottom: 10px;
  }

  .art-mail-img img {
    max-width: 95px;
    height: auto;
    filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.2));
  }

  /* CỘT PHẢI: FORM CẢI TIẾN HIỆN ĐẠI (CARD ELEVATION) */
  .col-right-form {
    background-color: #f8fafc;
    padding: 60px 70px;
    display: flex;
    align-items: center;
  }

  .form-card-container {
    width: 100%;
    max-width: 720px;
    background: #ffffff;
    border-radius: var(--radius-lg);
    padding: 44px 40px;
    box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.08), 0 0 0 1px rgba(0, 0, 0, 0.04);
  }

  .form-header-badge {
    margin-bottom: 28px;
  }

  .sub-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 800;
    color: #0284c7;
    background: #e0f2fe;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    margin-bottom: 12px;
    letter-spacing: 0.5px;
  }

  .connect-title {
    font-size: 34px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .connect-subtitle {
    font-size: 14.5px;
    color: #64748b;
    line-height: 1.6;
  }

  .form-grid-fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .field-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field-label {
    font-size: 13.5px;
    font-weight: 700;
    color: #334155;
  }

  .required {
    color: #ef4444;
  }

  .input-with-icon {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-with-icon i {
    position: absolute;
    left: 14px;
    color: #94a3b8;
    font-size: 15px;
    transition: color 0.25s ease;
  }

  .input-with-icon.icon-top i {
    top: 14px;
  }

  .modern-input,
  .modern-textarea {
    width: 100%;
    padding: 12px 14px 12px 42px;
    background-color: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    font-size: 14.5px;
    color: #0f172a;
    font-family: inherit;
    transition: all 0.25s ease;
  }

  .modern-input:focus,
  .modern-textarea:focus {
    outline: none;
    border-color: #0095da;
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(0, 149, 218, 0.15);
  }

  .input-with-icon:focus-within i {
    color: #0095da;
  }

  .textarea-item {
    margin-bottom: 24px;
  }

  .modern-textarea {
    resize: vertical;
  }

  .form-submit-row {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .btn-submit-premium {
    width: 100%;
    background: linear-gradient(135deg, #0095da 0%, #0284c7 100%);
    color: #ffffff;
    height: 50px;
    padding: 0 28px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    font-size: 15.5px;
    font-weight: 700;
    font-family: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 4px 14px rgba(0, 149, 218, 0.35);
    transition: all 0.3s ease;
  }

  .btn-submit-premium:hover {
    background: linear-gradient(135deg, #007bb5 0%, #0369a1 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 149, 218, 0.45);
  }

  .form-guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 12.5px;
    color: #64748b;
  }

  .form-guarantee i {
    color: #10b981;
  }

  /* BOTTOM BAR */
  .bottom-bar {
    background-color: #ffffff;
    border-top: 1px solid var(--gray-200);
    padding: 18px 0;
  }

  .bottom-bar-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13.5px;
    color: #64748b;
  }

  .social-center {
    display: flex;
    gap: 12px;
  }

  .social-center a {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    border: 1px solid #cbd5e1;
    color: #475569;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    transition: all 0.25s ease;
  }

  .social-center a:hover {
    border-color: #0095da;
    color: #ffffff;
    background-color: #0095da;
  }

  .links-right {
    display: flex;
    gap: 16px;
  }

  .links-right a {
    color: #64748b;
  }

  .links-right a:hover {
    color: #0095da;
  }

  @media (max-width: 992px) {
    .footer-columns-row {
      grid-template-columns: 1fr;
    }

    .col-right-form {
      padding: 40px 20px;
    }

    .form-card-container {
      padding: 30px 20px;
    }

    .form-grid-fields {
      grid-template-columns: 1fr;
    }

    .bottom-bar-container {
      flex-direction: column;
      gap: 14px;
      text-align: center;
    }
  }
</style>
